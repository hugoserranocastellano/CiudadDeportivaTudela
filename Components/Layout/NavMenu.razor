@inject NavigationManager Navigation

<div class="brand-row">
    <a class="brand" href="inicio">
        <img src="images/pena_ciudad-deportiva.jpg" alt="Peña Ciudad Deportiva" class="brand-logo" />
        <span class="brand-nombre">Peña Ciudad Deportiva</span>
        <span class="brand-lugar">Tudela</span>
    </a>
</div>

<input type="checkbox" title="Menú de navegación" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="inicio">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Inicio
            </NavLink>
        </div>

        <div class="nav-seccion">Mi actividad</div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="mis-tickets">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Tickets
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="reservas">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Reservas
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="sugerencias">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Sugerencias
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="eventos">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Eventos
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="directorio">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Socios
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="documentos">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Documentos
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="tudelanos-populares">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Tudelanos Populares
            </NavLink>
        </div>

        @if (esJunta)
        {
            <div class="nav-seccion">Junta</div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="articulos">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Artículos
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="socios">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Socios
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="mesas">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Mesas
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="reuniones">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Reuniones
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="reservas-limpieza">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Resumen limpieza
                </NavLink>
            </div>
        }

        @if (esJunta || esTesorero)
        {
            @if (!esJunta)
            {
                <div class="nav-seccion">Tesorería</div>
            }
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="contabilidad">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Contabilidad
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    private bool esJunta;
    private bool esTesorero;

    // Acceso a Contabilidad: junta, o el socio Id=4 (tesorero), hasta que se modele un rol propio.
    private const long IdTesorero = 4;

    protected override async Task OnInitializedAsync()
    {
        if (EstadoAutenticacion is null)
        {
            return;
        }

        var estado = await EstadoAutenticacion;
        esJunta = SocioAuth.EsJunta(estado.User);
        esTesorero = SocioAuth.SocioId(estado.User) == IdTesorero;
    }
}
