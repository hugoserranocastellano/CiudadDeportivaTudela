@page "/eventos"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Globalization
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Eventos</PageTitle>

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <a class="btn btn-outline-secondary btn-sm" href="inicio">← Volver</a>
    <h1 class="mb-0 text-center flex-grow-1">Eventos</h1>
    <a class="btn btn-outline-secondary btn-sm" href="mis-eventos">Mis eventos</a>
</div>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert"><code>@error</code></div>
}

<p class="text-muted small">
    <span class="leyenda-punto leyenda-obligatorio"></span> Obligatorio
    <span class="leyenda-punto leyenda-opcional ms-3"></span> Opcional
    <span class="leyenda-punto leyenda-reunion ms-3"></span> Reunión
</p>

<div class="d-flex align-items-center justify-content-between mb-3">
    <button class="btn btn-outline-secondary" @onclick="MesAnterior">← Ant.</button>
    <div class="text-center flex-grow-1">
        <div class="h4 mb-0 text-capitalize">@mesActual.ToString("MMMM", CultureInfo.GetCultureInfo("es-ES"))</div>
        <div class="text-muted">@mesActual.Year</div>
    </div>
    <button class="btn btn-outline-secondary" @onclick="MesSiguiente">Sig. →</button>
</div>

@if (dias is null)
{
    <p><em>Cargando...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered calendario-eventos align-top">
            <thead>
                <tr>
                    @foreach (var nombreDia in nombresDias)
                    {
                        <th class="text-center">@nombreDia</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var semana in Semanas())
                {
                    <tr>
                        @foreach (var dia in semana)
                        {
                            @if (dia is null)
                            {
                                <td class="bg-light"></td>
                            }
                            else
                            {
                                var celda = dia.Value;
                                <td class="@ClaseDia(celda)" style="cursor:pointer" @onclick="() => AbrirDia(celda)">
                                    <div class="dia-numero">
                                        @celda.Day
                                        @if (TieneEvento(celda))
                                        {
                                            <span class="dia-punto"></span>
                                        }
                                        @if (TieneReunion(celda))
                                        {
                                            <span class="dia-punto dia-punto-reunion"></span>
                                        }
                                    </div>
                                </td>
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (esJunta)
{
    <div class="card mb-4">
        <div class="card-header fw-semibold">Todos los eventos</div>
        <div class="card-body">
            @if (errorLista is not null)
            {
                <div class="alert alert-danger py-2">@errorLista</div>
            }

            @if (edicionLista is not null)
            {
                <EditForm Model="edicionLista" OnValidSubmit="GuardarLista" class="card mb-3">
                    <DataAnnotationsValidator />
                    <div class="card-header fw-semibold">Editar evento</div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Descripción</label>
                                <InputText class="form-control" @bind-Value="edicionLista.Descripcion" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Fecha</label>
                                <InputDate class="form-control" @bind-Value="fechaLista" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Voluntarios necesarios</label>
                                <InputNumber class="form-control" @bind-Value="edicionLista.VoluntariosNecesarios" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Fecha límite para apuntarse</label>
                                <InputDate class="form-control" @bind-Value="edicionLista.FechaTopeApuntarse" />
                            </div>
                            <div class="col-md-3 d-flex align-items-end">
                                <div class="form-check">
                                    <InputCheckbox class="form-check-input" @bind-Value="obligatorioLista" id="evtObligatorioLista" />
                                    <label class="form-check-label" for="evtObligatorioLista">Obligatorio</label>
                                </div>
                            </div>
                        </div>
                        <ValidationSummary class="mt-3 small" />
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <button type="submit" class="btn btn-pena">Guardar</button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => edicionLista = null">Cancelar</button>
                    </div>
                </EditForm>
            }

            @if (todosEventos is null)
            {
                <p><em>Cargando...</em></p>
            }
            else if (todosEventos.Count == 0)
            {
                <p class="text-muted">No hay eventos todavía.</p>
            }
            else
            {
                <div class="table-responsive tabla-marco">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Descripción</th>
                                <th>Tipo</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ev in todosEventos)
                            {
                                <tr>
                                    <td>@ev.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>@ev.Descripcion</td>
                                    <td>@(ev.Obligatorio == true ? "Obligatorio" : "Opcional")</td>
                                    <td>@(string.Equals(ev.Estado, "cerrado", StringComparison.OrdinalIgnoreCase) ? "Cerrado" : "Abierto")</td>
                                    <td class="text-end text-nowrap">
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditarEventoLista(ev)">Editar</button>
                                        @if (idBorrandoLista == ev.Id)
                                        {
                                            <button class="btn btn-sm btn-danger" @onclick="() => BorrarEventoLista(ev.Id)">Confirmar</button>
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => idBorrandoLista = null">No</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => idBorrandoLista = ev.Id">Borrar</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@if (diaSeleccionado is not null)
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-semibold">@diaSeleccionado.Value.ToString("dddd, d 'de' MMMM", CultureInfo.GetCultureInfo("es-ES"))</span>
            <button class="btn-close" @onclick="CerrarDia" aria-label="Cerrar"></button>
        </div>
        <div class="card-body">
            @if (eventosDelDia is null)
            {
                <p><em>Cargando...</em></p>
            }
            else if (eventosDelDia.Count == 0)
            {
                <p class="text-muted">No hay eventos este día.</p>
            }
            else
            {
                @foreach (var ev in eventosDelDia)
                {
                    var ocupadas = ocupacion.TryGetValue(ev.Id, out var oc) ? oc : 0;
                    var disponibles = ev.VoluntariosNecesarios is int max ? Math.Max(0, max - ocupadas) : (int?)null;
                    var propia = inscripcionPropia.TryGetValue(ev.Id, out var insc) ? insc : null;
                    var vencido = DateOnly.FromDateTime(ev.Fecha) < hoy;
                    var plazoPasado = ev.FechaTopeApuntarse is DateOnly tope && tope < hoy;
                    var cerradoManual = string.Equals(ev.Estado, "cerrado", StringComparison.OrdinalIgnoreCase);
                    var cerrado = !vencido && (cerradoManual || plazoPasado);

                    <div class="card mb-3 evento-card @(ev.Obligatorio == true ? "evento-obligatorio" : "evento-opcional")">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="mb-1">
                                    @ev.Descripcion
                                    <span class="badge @(ev.Obligatorio == true ? "text-bg-danger" : "text-bg-info")">
                                        @(ev.Obligatorio == true ? "Obligatorio" : "Opcional")
                                    </span>
                                </h5>
                                @if (esJunta)
                                {
                                    <span class="d-flex gap-2">
                                        @if (!vencido)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => AlternarCierre(ev.Id, cerradoManual)">
                                                @(cerradoManual ? "Reabrir inscripciones" : "Cerrar inscripciones")
                                            </button>
                                        }
                                        @if (idBorrando == ev.Id)
                                        {
                                            <button class="btn btn-sm btn-danger" @onclick="() => BorrarEvento(ev.Id)">Confirmar</button>
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => idBorrando = null">No</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => idBorrando = ev.Id">Borrar</button>
                                        }
                                    </span>
                                }
                            </div>
                            <p class="text-muted small mb-2">
                                @if (disponibles is not null)
                                {
                                    <text>Voluntarios: @disponibles / @ev.VoluntariosNecesarios</text>
                                }
                                else
                                {
                                    <text>Sin límite de voluntarios</text>
                                }
                                · @ocupadas inscrito(s)
                                @if (ev.FechaTopeApuntarse is DateOnly tope2)
                                {
                                    <text> · Fecha límite para apuntarse: @tope2.ToString("dd/MM/yyyy")</text>
                                }
                                @if (vencido)
                                {
                                    <text> · <span class="badge text-bg-dark">Vencido</span></text>
                                }
                                else if (cerrado)
                                {
                                    <text> · <span class="badge text-bg-secondary">Cerrado</span></text>
                                }
                            </p>

                            <div class="d-flex flex-wrap gap-2 mb-2">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => AlternarInscritos(ev.Id)">
                                    @(eventoInscritosAbierto == ev.Id ? "Ocultar inscritos" : "Ver inscritos")
                                </button>

                                @if (propia is null)
                                {
                                    <button class="btn btn-sm btn-pena" disabled="@(vencido || cerrado)" @onclick="() => Inscribirse(ev.Id)">Inscribirse</button>
                                }
                                else
                                {
                                    <span class="align-self-center small text-muted">
                                        @(propia.ListaEspera == true ? "En lista de espera" : "Inscrito")
                                    </span>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => Baja(ev.Id)">Darme de baja</button>
                                }
                            </div>

                            @if (eventoInscritosAbierto == ev.Id)
                            {
                                @if (!inscritosPorEvento.TryGetValue(ev.Id, out var inscritos))
                                {
                                    <p class="text-muted small"><em>Cargando...</em></p>
                                }
                                else if (inscritos.Count == 0)
                                {
                                    <p class="text-muted small">Nadie inscrito todavía.</p>
                                }
                                else
                                {
                                    <div class="d-flex flex-column gap-2">
                                        @foreach (var i in inscritos)
                                        {
                                            <div class="d-flex align-items-center gap-2 border rounded p-2 @(i.ListaEspera == true ? "bg-warning-subtle" : null)">
                                                @if (!string.IsNullOrWhiteSpace(i.SocioFoto))
                                                {
                                                    <img src="@i.SocioFoto" alt="@i.SocioNombre" class="rounded-circle" style="width:36px;height:36px;object-fit:cover;" />
                                                }
                                                else
                                                {
                                                    <div class="rounded-circle bg-secondary-subtle d-flex align-items-center justify-content-center" style="width:36px;height:36px;">?</div>
                                                }
                                                <div class="flex-grow-1">
                                                    <div class="fw-semibold">@i.SocioNombre @(i.ListaEspera == true ? " (lista de espera)" : "")</div>
                                                    <div class="small text-muted">
                                                        @i.FechaInscripcion?.ToString("dd/MM/yyyy HH:mm")
                                                        @if (!string.IsNullOrWhiteSpace(i.SocioTelefono))
                                                        {
                                                            <text> · Tfno: @i.SocioTelefono</text>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            }

            @if (reunionesDelDia is not null && reunionesDelDia.Count > 0)
            {
                @foreach (var reu in reunionesDelDia)
                {
                    var adjuntosVisibles = esJunta ? reu.Adjuntos : reu.Adjuntos.Where(a => a.Visible).ToList();

                    <div class="card mb-3 evento-card evento-reunion">
                        <div class="card-body">
                            <h5 class="mb-1">
                                @reu.Titulo
                                <span class="badge text-bg-warning text-dark">Reunión</span>
                                @if (esJunta && !reu.Visible)
                                {
                                    <span class="badge text-bg-secondary">Sólo junta</span>
                                }
                            </h5>
                            <p class="text-muted small mb-2">@(reu.TipoReunion?.Descripcion ?? "(sin tipo)")</p>

                            @if (adjuntosVisibles.Count == 0)
                            {
                                <p class="text-muted small mb-0">Sin adjuntos@(esJunta ? "" : " disponibles") todavía.</p>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-1">
                                    @foreach (var adj in adjuntosVisibles)
                                    {
                                        <a href="@adj.Url" target="_blank">@adj.Nombre</a>
                                    }
                                </div>
                            }

                            @if (esJunta)
                            {
                                <a class="btn btn-sm btn-outline-secondary mt-2" href="reuniones">Gestionar en Reuniones</a>
                            }
                        </div>
                    </div>
                }
            }

            @if (esJunta)
            {
                @if (edicion is null)
                {
                    <button class="btn btn-pena" @onclick="Nuevo">Nuevo evento este día</button>
                }
                else
                {
                    <EditForm Model="edicion" OnValidSubmit="Guardar" class="card">
                        <DataAnnotationsValidator />
                        <div class="card-header fw-semibold">Nuevo evento</div>
                        <div class="card-body">
                            @if (errorForm is not null)
                            {
                                <div class="alert alert-danger py-2">@errorForm</div>
                            }
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Descripción</label>
                                    <InputText class="form-control" @bind-Value="edicion.Descripcion" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Voluntarios necesarios</label>
                                    <InputNumber class="form-control" @bind-Value="edicion.VoluntariosNecesarios" />
                                </div>
                                <div class="col-md-3 d-flex align-items-end">
                                    <div class="form-check">
                                        <InputCheckbox class="form-check-input" @bind-Value="obligatorio" id="evtObligatorio" />
                                        <label class="form-check-label" for="evtObligatorio">Obligatorio</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Fecha límite para apuntarse</label>
                                    <InputDate class="form-control" @bind-Value="edicion.FechaTopeApuntarse" />
                                </div>
                            </div>
                            <ValidationSummary class="mt-3 small" />
                        </div>
                        <div class="card-footer d-flex gap-2">
                            <button type="submit" class="btn btn-pena">Guardar</button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="CancelarForm">Cancelar</button>
                        </div>
                    </EditForm>
                }
            }
        </div>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    private static readonly string[] nombresDias = { "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom" };

    private long? socioId;
    private bool esJunta;

    private DateOnly hoy;
    private DateOnly mesActual;
    private List<DateOnly>? dias;
    private Dictionary<DateOnly, List<Evento>> eventosPorFecha = new();
    private Dictionary<DateOnly, List<Reunion>> reunionesPorFecha = new();
    private Dictionary<long, int> ocupacion = new();
    private Dictionary<long, EventoInscripcion> inscripcionPropia = new();
    private string? error;

    private DateOnly? diaSeleccionado;
    private List<Evento>? eventosDelDia;
    private List<Reunion>? reunionesDelDia;
    private long? eventoInscritosAbierto;
    private Dictionary<long, List<InscritoFila>> inscritosPorEvento = new();
    private long? idBorrando;

    private Evento? edicion;
    private bool obligatorio;
    private string? errorForm;

    private List<Evento>? todosEventos;
    private Evento? edicionLista;
    private bool obligatorioLista;
    private DateOnly fechaLista;
    private long? idBorrandoLista;
    private string? errorLista;

    protected override async Task OnInitializedAsync()
    {
        hoy = DateOnly.FromDateTime(DateTime.Today);
        mesActual = hoy;

        if (EstadoAutenticacion is not null)
        {
            var estado = await EstadoAutenticacion;
            socioId = SocioAuth.SocioId(estado.User);
            esJunta = SocioAuth.EsJunta(estado.User);
        }

        await CargarMes();

        if (esJunta)
        {
            await CargarTodosEventos();
        }
    }

    private async Task CargarTodosEventos()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            todosEventos = await db.Eventos
                .AsNoTracking()
                .OrderByDescending(e => e.Fecha)
                .ToListAsync();

            errorLista = null;
        }
        catch (Exception ex)
        {
            todosEventos ??= new List<Evento>();
            errorLista = ex.Message;
        }
    }

    private void EditarEventoLista(Evento evento)
    {
        edicionLista = new Evento
        {
            Id = evento.Id,
            Descripcion = evento.Descripcion,
            Fecha = evento.Fecha,
            VoluntariosNecesarios = evento.VoluntariosNecesarios,
            Obligatorio = evento.Obligatorio,
            FechaTopeApuntarse = evento.FechaTopeApuntarse,
            Estado = evento.Estado,
        };
        obligatorioLista = evento.Obligatorio == true;
        fechaLista = DateOnly.FromDateTime(evento.Fecha);
        idBorrandoLista = null;
        errorLista = null;
    }

    private async Task GuardarLista()
    {
        if (edicionLista is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(edicionLista.Descripcion))
        {
            errorLista = "La descripción es obligatoria.";
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var nuevaFecha = DateTime.SpecifyKind(fechaLista.ToDateTime(TimeOnly.MinValue), DateTimeKind.Utc);

            await db.Eventos.Where(e => e.Id == edicionLista.Id)
                .ExecuteUpdateAsync(e => e
                    .SetProperty(x => x.Descripcion, edicionLista.Descripcion)
                    .SetProperty(x => x.Fecha, nuevaFecha)
                    .SetProperty(x => x.VoluntariosNecesarios, edicionLista.VoluntariosNecesarios)
                    .SetProperty(x => x.Obligatorio, obligatorioLista)
                    .SetProperty(x => x.FechaTopeApuntarse, edicionLista.FechaTopeApuntarse));

            edicionLista = null;
            errorLista = null;
            await CargarTodosEventos();
            await CargarMes();
            if (diaSeleccionado is not null)
            {
                AbrirDia(diaSeleccionado.Value);
            }
        }
        catch (Exception ex)
        {
            errorLista = ex.InnerException?.Message ?? ex.Message;
        }
    }

    private async Task BorrarEventoLista(long id)
    {
        idBorrandoLista = null;
        await BorrarEvento(id);
        await CargarTodosEventos();
    }

    private bool TieneEvento(DateOnly fecha) => eventosPorFecha.ContainsKey(fecha);

    private bool TieneReunion(DateOnly fecha) => reunionesPorFecha.ContainsKey(fecha);

    private string ClaseDia(DateOnly celda)
    {
        var clases = new List<string> { "dia-habilitado" };
        if (celda.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)
        {
            clases.Add("dia-finde");
        }
        if (eventosPorFecha.TryGetValue(celda, out var eventosDia))
        {
            clases.Add(eventosDia.Any(e => e.Obligatorio == true) ? "dia-evento-obligatorio" : "dia-evento-opcional");
        }
        if (reunionesPorFecha.ContainsKey(celda))
        {
            clases.Add("dia-reunion");
        }
        if (celda == hoy)
        {
            clases.Add("dia-hoy");
        }
        return string.Join(' ', clases);
    }

    private IEnumerable<DateOnly?[]> Semanas()
    {
        if (dias is null)
        {
            yield break;
        }

        var primerDia = new DateOnly(mesActual.Year, mesActual.Month, 1);
        var offset = ((int)primerDia.DayOfWeek + 6) % 7; // lunes = 0
        var celdas = new List<DateOnly?>();
        for (var i = 0; i < offset; i++)
        {
            celdas.Add(null);
        }
        celdas.AddRange(dias.Select(d => (DateOnly?)d));
        while (celdas.Count % 7 != 0)
        {
            celdas.Add(null);
        }

        for (var i = 0; i < celdas.Count; i += 7)
        {
            yield return celdas.Skip(i).Take(7).ToArray();
        }
    }

    private async Task MesAnterior()
    {
        mesActual = mesActual.AddMonths(-1);
        CerrarDia();
        await CargarMes();
    }

    private async Task MesSiguiente()
    {
        mesActual = mesActual.AddMonths(1);
        CerrarDia();
        await CargarMes();
    }

    private async Task CargarMes()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var primerDia = new DateOnly(mesActual.Year, mesActual.Month, 1);
            var ultimoDia = primerDia.AddMonths(1).AddDays(-1);
            dias = Enumerable.Range(0, ultimoDia.Day).Select(i => primerDia.AddDays(i)).ToList();

            var desde = DateTime.SpecifyKind(primerDia.ToDateTime(TimeOnly.MinValue), DateTimeKind.Utc);
            var hasta = DateTime.SpecifyKind(ultimoDia.AddDays(1).ToDateTime(TimeOnly.MinValue), DateTimeKind.Utc);
            var eventosDelMes = await db.Eventos
                .AsNoTracking()
                .Where(e => e.Fecha >= desde && e.Fecha < hasta)
                .OrderBy(e => e.Fecha)
                .ToListAsync();

            eventosPorFecha = eventosDelMes
                .GroupBy(e => DateOnly.FromDateTime(e.Fecha))
                .ToDictionary(g => g.Key, g => g.ToList());

            var eventoIds = eventosDelMes.Select(e => e.Id).ToList();

            ocupacion = (await db.EventoInscripciones
                    .AsNoTracking()
                    .Where(i => i.EventoId != null && eventoIds.Contains(i.EventoId.Value)
                        && i.Acude == true && i.ListaEspera != true)
                    .GroupBy(i => i.EventoId!.Value)
                    .Select(g => new { EventoId = g.Key, Total = g.Count() })
                    .ToListAsync())
                .ToDictionary(x => x.EventoId, x => x.Total);

            inscripcionPropia = socioId is null
                ? new Dictionary<long, EventoInscripcion>()
                : (await db.EventoInscripciones
                    .AsNoTracking()
                    .Where(i => i.SocioId == socioId && i.EventoId != null && eventoIds.Contains(i.EventoId.Value))
                    .ToListAsync())
                    .ToDictionary(i => i.EventoId!.Value);

            var reunionesQuery = db.Reuniones
                .AsNoTracking()
                .Include(r => r.TipoReunion)
                .Include(r => r.Adjuntos)
                .Where(r => r.FechaPrevista >= primerDia && r.FechaPrevista <= ultimoDia);
            if (!esJunta)
            {
                reunionesQuery = reunionesQuery.Where(r => r.Visible);
            }

            var reunionesDelMes = await reunionesQuery.OrderBy(r => r.FechaPrevista).ToListAsync();

            reunionesPorFecha = reunionesDelMes
                .GroupBy(r => r.FechaPrevista)
                .ToDictionary(g => g.Key, g => g.ToList());

            error = null;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private void AbrirDia(DateOnly fecha)
    {
        diaSeleccionado = fecha;
        eventosDelDia = eventosPorFecha.TryGetValue(fecha, out var lista) ? lista : new List<Evento>();
        reunionesDelDia = reunionesPorFecha.TryGetValue(fecha, out var reuniones) ? reuniones : new List<Reunion>();
        edicion = null;
        errorForm = null;
        idBorrando = null;
        eventoInscritosAbierto = null;
        inscritosPorEvento.Clear();
    }

    private void CerrarDia()
    {
        diaSeleccionado = null;
        eventosDelDia = null;
        reunionesDelDia = null;
        edicion = null;
        idBorrando = null;
        eventoInscritosAbierto = null;
        inscritosPorEvento.Clear();
    }

    private async Task AlternarInscritos(long eventoId)
    {
        if (eventoInscritosAbierto == eventoId)
        {
            eventoInscritosAbierto = null;
            return;
        }

        eventoInscritosAbierto = eventoId;

        if (!inscritosPorEvento.ContainsKey(eventoId))
        {
            try
            {
                await using var db = await DbFactory.CreateDbContextAsync();

                var lista = await db.EventoInscripciones
                    .AsNoTracking()
                    .Where(i => i.EventoId == eventoId)
                    .OrderBy(i => i.FechaInscripcion)
                    .Select(i => new InscritoFila(
                        i.SocioId,
                        i.Socio != null ? $"{i.Socio.Nombre} {i.Socio.Apellidos}".Trim() : "(sin socio)",
                        i.Socio != null ? i.Socio.UrlFoto : null,
                        i.Socio != null ? i.Socio.Telefono : null,
                        i.FechaInscripcion,
                        i.ListaEspera))
                    .ToListAsync();

                inscritosPorEvento[eventoId] = lista;
            }
            catch (Exception ex)
            {
                error = ex.Message;
            }
        }
    }

    private async Task Inscribirse(long eventoId)
    {
        if (socioId is null)
        {
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var yaInscrito = await db.EventoInscripciones
                .AnyAsync(i => i.EventoId == eventoId && i.SocioId == socioId);
            if (yaInscrito)
            {
                await CargarMes();
                AbrirDia(diaSeleccionado!.Value);
                return;
            }

            var evento = await db.Eventos.AsNoTracking().FirstOrDefaultAsync(e => e.Id == eventoId);
            if (evento is null)
            {
                return;
            }

            var ocupadas = await db.EventoInscripciones
                .CountAsync(i => i.EventoId == eventoId && i.Acude == true && i.ListaEspera != true);

            var listaEspera = evento.VoluntariosNecesarios is int max && ocupadas >= max;

            db.EventoInscripciones.Add(new EventoInscripcion
            {
                EventoId = eventoId,
                SocioId = socioId,
                Acude = true,
                ListaEspera = listaEspera,
                FechaInscripcion = DateTime.UtcNow,
            });
            await db.SaveChangesAsync();

            inscritosPorEvento.Remove(eventoId);
            await CargarMes();
            AbrirDia(diaSeleccionado!.Value);
            if (eventoInscritosAbierto == eventoId)
            {
                await AlternarInscritosForzado(eventoId);
            }

            error = null;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task Baja(long eventoId)
    {
        if (socioId is null)
        {
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var propia = await db.EventoInscripciones
                .FirstOrDefaultAsync(i => i.EventoId == eventoId && i.SocioId == socioId);
            if (propia is null)
            {
                return;
            }

            var liberaPlaza = propia.ListaEspera != true;

            db.EventoInscripciones.Remove(propia);
            await db.SaveChangesAsync();

            if (liberaPlaza)
            {
                var siguiente = await db.EventoInscripciones
                    .Where(i => i.EventoId == eventoId && i.ListaEspera == true)
                    .OrderBy(i => i.FechaInscripcion)
                    .FirstOrDefaultAsync();

                if (siguiente is not null)
                {
                    siguiente.ListaEspera = false;
                    await db.SaveChangesAsync();
                }
            }

            inscritosPorEvento.Remove(eventoId);
            await CargarMes();
            AbrirDia(diaSeleccionado!.Value);
            if (eventoInscritosAbierto == eventoId)
            {
                await AlternarInscritosForzado(eventoId);
            }

            error = null;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task AlternarInscritosForzado(long eventoId)
    {
        eventoInscritosAbierto = null;
        await AlternarInscritos(eventoId);
    }

    private void Nuevo()
    {
        if (diaSeleccionado is null)
        {
            return;
        }

        edicion = new Evento { Fecha = DateTime.SpecifyKind(diaSeleccionado.Value.ToDateTime(TimeOnly.MinValue), DateTimeKind.Utc) };
        obligatorio = false;
        errorForm = null;
    }

    private void CancelarForm()
    {
        edicion = null;
        errorForm = null;
    }

    private async Task Guardar()
    {
        if (edicion is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(edicion.Descripcion))
        {
            errorForm = "La descripción es obligatoria.";
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            edicion.Obligatorio = obligatorio;
            edicion.Estado ??= "abierto";
            db.Eventos.Add(edicion);
            await db.SaveChangesAsync();

            edicion = null;
            errorForm = null;
            await CargarMes();
            AbrirDia(diaSeleccionado!.Value);
            await CargarTodosEventos();
        }
        catch (Exception ex)
        {
            errorForm = ex.Message;
        }
    }

    private async Task AlternarCierre(long id, bool cerradoActualmente)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var nuevoEstado = cerradoActualmente ? "abierto" : "cerrado";
            await db.Eventos.Where(e => e.Id == id)
                .ExecuteUpdateAsync(e => e.SetProperty(x => x.Estado, nuevoEstado));

            await CargarMes();
            if (diaSeleccionado is not null)
            {
                AbrirDia(diaSeleccionado.Value);
            }
            await CargarTodosEventos();

            error = null;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task BorrarEvento(long id)
    {
        idBorrando = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            await db.EventoInscripciones.Where(i => i.EventoId == id).ExecuteDeleteAsync();
            await db.Eventos.Where(e => e.Id == id).ExecuteDeleteAsync();

            await CargarMes();
            if (diaSeleccionado is not null)
            {
                AbrirDia(diaSeleccionado.Value);
            }

            error = null;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private record InscritoFila(
        long? SocioId, string SocioNombre, string? SocioFoto, string? SocioTelefono,
        DateTime? FechaInscripcion, bool? ListaEspera);
}
