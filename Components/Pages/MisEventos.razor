@page "/mis-eventos"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Mis eventos</PageTitle>

<a class="btn btn-outline-secondary btn-sm mb-3" href="inicio">← Volver</a>

<h1 class="mb-3">Mis eventos</h1>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert"><code>@error</code></div>
}

@if (inscripciones is null)
{
    <p><em>Cargando...</em></p>
}
else if (inscripciones.Count == 0)
{
    <p><em>No estás inscrito en ningún evento.</em></p>
}
else
{
    <div class="table-responsive tabla-marco">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th role="button" @onclick='() => Ordenar("evento")'>Evento@(Flecha("evento"))</th>
                    <th role="button" @onclick='() => Ordenar("fecha")'>Fecha@(Flecha("fecha"))</th>
                    <th role="button" @onclick='() => Ordenar("acude")'>Acude@(Flecha("acude"))</th>
                    <th role="button" @onclick='() => Ordenar("espera")'>Lista de espera@(Flecha("espera"))</th>
                    <th role="button" @onclick='() => Ordenar("inscripcion")'>Inscripción@(Flecha("inscripcion"))</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inscripcion in Ordenadas)
                {
                    <tr class="@(inscripcion.ListaEspera == true ? "table-warning" : null)">
                        <td>@DescripcionEvento(inscripcion.EventoId)</td>
                        <td>@FechaEvento(inscripcion.EventoId)?.ToString("dd/MM/yyyy")</td>
                        <td>@(inscripcion.Acude == true ? "Sí" : "No")</td>
                        <td>@(inscripcion.ListaEspera == true ? "Sí" : "No")</td>
                        <td>@inscripcion.FechaInscripcion?.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    private long? socioId;
    private List<EventoInscripcion>? inscripciones;
    private Dictionary<long, Evento> eventos = new();
    private string? error;

    private string DescripcionEvento(long? id) =>
        id is not null && eventos.TryGetValue(id.Value, out var evento) ? evento.Descripcion : "—";

    private DateTime? FechaEvento(long? id) =>
        id is not null && eventos.TryGetValue(id.Value, out var evento) ? evento.Fecha : null;

    private string ordenCampo = "inscripcion";
    private bool ordenDescendente = true;

    private List<EventoInscripcion> Ordenadas
    {
        get
        {
            if (inscripciones is null)
            {
                return new List<EventoInscripcion>();
            }

            Func<EventoInscripcion, object?> clave = ordenCampo switch
            {
                "evento" => i => DescripcionEvento(i.EventoId),
                "fecha" => i => FechaEvento(i.EventoId),
                "acude" => i => i.Acude,
                "espera" => i => i.ListaEspera,
                _ => i => i.FechaInscripcion,
            };

            IEnumerable<EventoInscripcion> resultado = ordenDescendente
                ? inscripciones.OrderByDescending(clave)
                : inscripciones.OrderBy(clave);

            return resultado.ToList();
        }
    }

    private void Ordenar(string campo)
    {
        if (ordenCampo == campo)
        {
            ordenDescendente = !ordenDescendente;
        }
        else
        {
            ordenCampo = campo;
            ordenDescendente = false;
        }
    }

    private string Flecha(string campo) =>
        ordenCampo != campo ? string.Empty : ordenDescendente ? " ▼" : " ▲";

    protected override async Task OnInitializedAsync()
    {
        if (EstadoAutenticacion is null)
        {
            return;
        }

        var estado = await EstadoAutenticacion;
        socioId = SocioAuth.SocioId(estado.User);

        await Cargar();
    }

    private async Task Cargar()
    {
        if (socioId is null)
        {
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            eventos = await db.Eventos.AsNoTracking().ToDictionaryAsync(e => e.Id);

            inscripciones = await db.EventoInscripciones
                .AsNoTracking()
                .Where(i => i.SocioId == socioId)
                .OrderByDescending(i => i.FechaInscripcion)
                .ToListAsync();

            error = null;
        }
        catch (Exception ex)
        {
            inscripciones ??= new List<EventoInscripcion>();
            error = ex.Message;
        }
    }
}
