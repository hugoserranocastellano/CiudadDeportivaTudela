@page "/movimientos-stock"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Movimientos de stock</PageTitle>
<JuntaGuard />

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">Movimientos de stock</h1>
    <button class="btn btn-pena" @onclick="Nuevo">Nuevo movimiento</button>
</div>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert"><code>@error</code></div>
}

@if (edicion is not null)
{
    <EditForm Model="edicion" OnValidSubmit="Guardar" class="card mb-4">
        <div class="card-header fw-semibold">@(esNuevo ? "Nuevo movimiento" : $"Editar movimiento #{edicion.Id}")</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Artículo</label>
                    <InputSelect class="form-select" @bind-Value="edicion.ArticuloId">
                        <option value="">(elige un artículo)</option>
                        @foreach (var articulo in articulos)
                        {
                            <option value="@articulo.Id">@articulo.Texto</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Tipo de movimiento</label>
                    <InputSelect class="form-select" @bind-Value="edicion.TipoMovimiento">
                        <option value="">(sin tipo)</option>
                        <option value="entrada">entrada</option>
                        <option value="salida">salida</option>
                        <option value="ajuste">ajuste</option>
                        <option value="merma">merma</option>
                    </InputSelect>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Cantidad</label>
                    <InputNumber class="form-control" @bind-Value="edicion.Cantidad" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Ticket (opcional)</label>
                    <InputSelect class="form-select" @bind-Value="edicion.TicketId">
                        <option value="">(sin ticket)</option>
                        @foreach (var ticket in tickets)
                        {
                            <option value="@ticket.Id">@ticket.Texto</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-12">
                    <label class="form-label">Observaciones</label>
                    <InputTextArea class="form-control" rows="2" @bind-Value="edicion.Observaciones" />
                </div>
            </div>
        </div>
        <div class="card-footer d-flex gap-2">
            <button type="submit" class="btn btn-pena">Guardar</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancelar">Cancelar</button>
        </div>
    </EditForm>
}

@if (movimientos is null)
{
    <p><em>Cargando...</em></p>
}
else if (movimientos.Count == 0)
{
    <p><em>No hay movimientos registrados.</em></p>
}
else
{
    <p class="text-muted">@movimientos.Count movimiento(s).</p>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Fecha</th>
                    <th>Artículo</th>
                    <th>Tipo</th>
                    <th class="text-end">Cantidad</th>
                    <th>Ticket</th>
                    <th>Observaciones</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var movimiento in movimientos)
                {
                    <tr>
                        <td>@movimiento.Id</td>
                        <td>@movimiento.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@Texto(articulosPorId, movimiento.ArticuloId)</td>
                        <td>@movimiento.TipoMovimiento</td>
                        <td class="text-end">@movimiento.Cantidad</td>
                        <td>@Texto(ticketsPorId, movimiento.TicketId)</td>
                        <td>@movimiento.Observaciones</td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Editar(movimiento.Id)">Editar</button>
                            @if (idBorrando == movimiento.Id)
                            {
                                <button class="btn btn-sm btn-danger" @onclick="() => Borrar(movimiento.Id)">Confirmar</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => idBorrando = null">No</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => idBorrando = movimiento.Id">Borrar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Fila>? movimientos;
    private List<Opcion> articulos = new();
    private List<Opcion> tickets = new();
    private Dictionary<long, string> articulosPorId = new();
    private Dictionary<long, string> ticketsPorId = new();
    private MovimientoStock? edicion;
    private bool esNuevo;
    private long? idBorrando;
    private string? error;

    private static string Texto(Dictionary<long, string> indice, long? id) =>
        id is not null && indice.TryGetValue(id.Value, out var texto) ? texto : "—";

    protected override Task OnInitializedAsync() => Cargar();

    private async Task Cargar()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            articulos = (await db.Articulos
                    .AsNoTracking()
                    .OrderBy(a => a.Descripcion)
                    .Select(a => new { a.Id, a.Descripcion, a.StockActual })
                    .ToListAsync())
                .Select(a => new Opcion(a.Id, $"{a.Descripcion} (stock {a.StockActual})"))
                .ToList();

            tickets = (await db.Tickets
                    .AsNoTracking()
                    .OrderByDescending(t => t.Fecha)
                    .Select(t => new { t.Id, t.Fecha })
                    .ToListAsync())
                .Select(t => new Opcion(t.Id, $"#{t.Id} · {t.Fecha?.ToString("dd/MM/yyyy HH:mm")}"))
                .ToList();

            articulosPorId = articulos.ToDictionary(a => a.Id, a => a.Texto);
            ticketsPorId = tickets.ToDictionary(t => t.Id, t => t.Texto);

            movimientos = await db.MovimientosStock
                .AsNoTracking()
                .OrderByDescending(m => m.CreatedAt)
                .ThenByDescending(m => m.Id)
                .Select(m => new Fila(
                    m.Id,
                    m.CreatedAt,
                    m.ArticuloId,
                    m.TipoMovimiento,
                    m.Cantidad,
                    m.TicketId,
                    m.Observaciones))
                .ToListAsync();

            error = null;
        }
        catch (Exception ex)
        {
            movimientos ??= new List<Fila>();
            error = ex.Message;
        }
    }

    private void Nuevo()
    {
        edicion = new MovimientoStock { TipoMovimiento = "entrada", Cantidad = 1 };
        esNuevo = true;
        idBorrando = null;
    }

    private async Task Editar(long id)
    {
        idBorrando = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            edicion = await db.MovimientosStock.AsNoTracking().FirstOrDefaultAsync(m => m.Id == id);
            esNuevo = false;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private void Cancelar() => edicion = null;

    private async Task Guardar()
    {
        if (edicion is null)
        {
            return;
        }

        if (edicion.ArticuloId is null)
        {
            error = "Hay que elegir un artículo.";
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            if (esNuevo)
            {
                db.MovimientosStock.Add(edicion);
            }
            else
            {
                db.MovimientosStock.Update(edicion);
            }

            await db.SaveChangesAsync();
            edicion = null;
            await Cargar();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task Borrar(long id)
    {
        idBorrando = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            await db.MovimientosStock.Where(m => m.Id == id).ExecuteDeleteAsync();
            await Cargar();
        }
        catch (Exception ex)
        {
            error = $"No se pudo borrar el movimiento: {ex.Message}";
        }
    }

    private record Fila(
        long Id,
        DateTime? CreatedAt,
        long? ArticuloId,
        string? TipoMovimiento,
        int? Cantidad,
        long? TicketId,
        string? Observaciones);

    private record Opcion(long Id, string Texto);
}
