@page "/mis-sugerencias"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Mis sugerencias</PageTitle>

<a class="btn btn-outline-secondary btn-sm mb-3" href="inicio">← Volver</a>

<h1 class="mb-3">Mis sugerencias</h1>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert"><code>@error</code></div>
}

@if (sugerencias is null)
{
    <p><em>Cargando...</em></p>
}
else if (sugerencias.Count == 0)
{
    <p><em>No has enviado sugerencias.</em></p>
}
else
{
    <div class="table-responsive tabla-marco">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th role="button" @onclick='() => Ordenar("id")'>#@(Flecha("id"))</th>
                    <th role="button" @onclick='() => Ordenar("fecha")'>Fecha@(Flecha("fecha"))</th>
                    <th role="button" @onclick='() => Ordenar("sugerencia")'>Sugerencia@(Flecha("sugerencia"))</th>
                    <th role="button" @onclick='() => Ordenar("respuesta")'>Respuesta de la junta@(Flecha("respuesta"))</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sugerencia in Ordenados)
                {
                    <tr class="@(string.IsNullOrWhiteSpace(sugerencia.Respuesta) ? "table-warning" : null)">
                        <td>@sugerencia.Id</td>
                        <td>@sugerencia.Fecha?.ToString("dd/MM/yyyy")</td>
                        <td>@sugerencia.Descripcion</td>
                        <td>
                            @sugerencia.Respuesta
                            @if (sugerencia.FechaRespuesta is not null)
                            {
                                <div class="text-muted small">@sugerencia.FechaRespuesta?.ToString("dd/MM/yyyy")</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    private long? socioId;
    private List<Fila>? sugerencias;
    private string? error;

    private string ordenCampo = "fecha";
    private bool ordenDescendente = true;

    private List<Fila> Ordenados
    {
        get
        {
            if (sugerencias is null)
            {
                return new List<Fila>();
            }

            Func<Fila, object?> clave = ordenCampo switch
            {
                "id" => s => s.Id,
                "sugerencia" => s => s.Descripcion,
                "respuesta" => s => s.Respuesta,
                _ => s => s.Fecha,
            };

            IEnumerable<Fila> resultado = ordenDescendente
                ? sugerencias.OrderByDescending(clave)
                : sugerencias.OrderBy(clave);

            return resultado.ToList();
        }
    }

    private void Ordenar(string campo)
    {
        if (ordenCampo == campo)
        {
            ordenDescendente = !ordenDescendente;
        }
        else
        {
            ordenCampo = campo;
            ordenDescendente = false;
        }
    }

    private string Flecha(string campo) =>
        ordenCampo != campo ? string.Empty : ordenDescendente ? " ▼" : " ▲";

    protected override async Task OnInitializedAsync()
    {
        if (EstadoAutenticacion is null)
        {
            return;
        }

        var estado = await EstadoAutenticacion;
        socioId = SocioAuth.SocioId(estado.User);

        await Cargar();
    }

    private async Task Cargar()
    {
        if (socioId is null)
        {
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            sugerencias = await db.Sugerencias
                .AsNoTracking()
                .Where(s => s.SocioId == socioId)
                .OrderByDescending(s => s.Fecha)
                .ThenByDescending(s => s.Id)
                .Select(s => new Fila(s.Id, s.Fecha, s.Descripcion, s.Respuesta, s.FechaRespuesta))
                .ToListAsync();

            error = null;
        }
        catch (Exception ex)
        {
            sugerencias ??= new List<Fila>();
            error = ex.Message;
        }
    }

    private record Fila(long Id, DateTime? Fecha, string Descripcion, string? Respuesta, DateTime? FechaRespuesta);
}
