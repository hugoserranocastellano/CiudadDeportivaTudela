@page "/tipos-reserva"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Tipos de reserva</PageTitle>
<JuntaGuard />

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">Tipos de reserva</h1>
    <button class="btn btn-pena" @onclick="Nuevo">Nuevo tipo</button>
</div>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert"><code>@error</code></div>
}

@if (edicion is not null)
{
    <EditForm Model="edicion" OnValidSubmit="Guardar" class="card mb-4">
        <DataAnnotationsValidator />
        <div class="card-header fw-semibold">@(esNuevo ? "Nuevo tipo de reserva" : $"Editar «{edicion.Descripcion}»")</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Descripción</label>
                    <InputText class="form-control" @bind-Value="edicion.Descripcion" />
                </div>
            </div>
            <ValidationSummary class="mt-3 small" />
        </div>
        <div class="card-footer d-flex gap-2">
            <button type="submit" class="btn btn-pena">Guardar</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancelar">Cancelar</button>
        </div>
    </EditForm>
}

@if (tipos is null)
{
    <p><em>Cargando...</em></p>
}
else if (tipos.Count == 0)
{
    <p><em>No hay tipos de reserva todavía.</em></p>
}
else
{
    <p class="text-muted">@tipos.Count tipo(s).</p>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Descripción</th>
                    <th class="text-end">Reservas</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fila in tipos)
                {
                    <tr>
                        <td>@fila.Tipo.Descripcion</td>
                        <td class="text-end">@fila.NumeroReservas</td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Editar(fila.Tipo)">Editar</button>
                            @if (idBorrando == fila.Tipo.Id)
                            {
                                <button class="btn btn-sm btn-danger" @onclick="() => Borrar(fila.Tipo.Id)">Confirmar</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => idBorrando = null">No</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => idBorrando = fila.Tipo.Id">Borrar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Fila>? tipos;
    private TipoReserva? edicion;
    private bool esNuevo;
    private long? idBorrando;
    private string? error;

    protected override Task OnInitializedAsync() => Cargar();

    private async Task Cargar()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            tipos = await db.TiposReserva
                .AsNoTracking()
                .OrderBy(t => t.Descripcion)
                .Select(t => new Fila(t, t.Reservas.Count))
                .ToListAsync();

            error = null;
        }
        catch (Exception ex)
        {
            tipos ??= new List<Fila>();
            error = ex.Message;
        }
    }

    private void Nuevo()
    {
        edicion = new TipoReserva();
        esNuevo = true;
        idBorrando = null;
    }

    private void Editar(TipoReserva tipo)
    {
        edicion = new TipoReserva { Id = tipo.Id, Descripcion = tipo.Descripcion };
        esNuevo = false;
        idBorrando = null;
    }

    private void Cancelar() => edicion = null;

    private async Task Guardar()
    {
        if (edicion is null)
        {
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            if (esNuevo)
            {
                db.TiposReserva.Add(edicion);
            }
            else
            {
                db.TiposReserva.Update(edicion);
            }

            await db.SaveChangesAsync();
            edicion = null;
            await Cargar();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task Borrar(long id)
    {
        idBorrando = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            await db.TiposReserva.Where(t => t.Id == id).ExecuteDeleteAsync();
            await Cargar();
        }
        catch (Exception ex)
        {
            error = $"No se pudo borrar el tipo (puede tener reservas asociadas): {ex.Message}";
        }
    }

    private record Fila(TipoReserva Tipo, int NumeroReservas);
}
