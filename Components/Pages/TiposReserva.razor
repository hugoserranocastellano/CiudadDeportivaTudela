@page "/tipos-reserva"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Tipos de reserva</PageTitle>
<JuntaGuard />

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <a class="btn btn-outline-secondary btn-sm" href="inicio">← Volver</a>
    <h1 class="mb-0 text-center flex-grow-1">Tipos de reserva</h1>
    <button class="btn btn-pena" @onclick="Nuevo">Nuevo tipo</button>
</div>

@if (mensajeExito is not null)
{
    <div class="alert alert-success py-2">@mensajeExito</div>
}

@if (error is not null)
{
    <div class="alert alert-danger" role="alert"><code>@error</code></div>
}

@if (edicion is not null)
{
    <EditForm Model="edicion" OnValidSubmit="Guardar" class="card mb-4">
        <DataAnnotationsValidator />
        <div class="card-header fw-semibold">@(esNuevo ? "Nuevo tipo de reserva" : $"Editar «{edicion.Descripcion}»")</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label">Descripción</label>
                    <InputText class="form-control" @bind-Value="edicion.Descripcion" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Orden</label>
                    <InputNumber class="form-control" @bind-Value="edicion.Orden" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Hora inicio</label>
                    <InputDate Type="InputDateType.Time" class="form-control" @bind-Value="edicion.HoraInicio" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Hora fin</label>
                    <InputDate Type="InputDateType.Time" class="form-control" @bind-Value="edicion.HoraFin" />
                </div>
            </div>
            <ValidationSummary class="mt-3 small" />
        </div>
        <div class="card-footer d-flex gap-2">
            <button type="submit" class="btn btn-pena">Guardar</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancelar">Cancelar</button>
        </div>
    </EditForm>
}

@if (tipos is null)
{
    <p><em>Cargando...</em></p>
}
else if (tipos.Count == 0)
{
    <p><em>No hay tipos de reserva todavía.</em></p>
}
else
{
    <p class="text-muted">@tipos.Count tipo(s).</p>

    <div class="table-responsive tabla-marco">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th role="button" @onclick='() => Ordenar("orden")'>Orden@(Flecha("orden"))</th>
                    <th role="button" @onclick='() => Ordenar("descripcion")'>Descripción@(Flecha("descripcion"))</th>
                    <th>Horario</th>
                    <th class="text-end" role="button" @onclick='() => Ordenar("reservas")'>Reservas@(Flecha("reservas"))</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fila in Ordenados)
                {
                    <tr>
                        <td>@fila.Tipo.Orden</td>
                        <td>@fila.Tipo.Descripcion</td>
                        <td>@(fila.Tipo.HoraInicio is null ? "—" : $"{fila.Tipo.HoraInicio:HH\\:mm} - {fila.Tipo.HoraFin:HH\\:mm}")</td>
                        <td class="text-end">@fila.NumeroReservas</td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Editar(fila.Tipo)">Editar</button>
                            @if (idBorrando == fila.Tipo.Id)
                            {
                                <button class="btn btn-sm btn-danger" @onclick="() => Borrar(fila.Tipo.Id)">Confirmar</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => idBorrando = null">No</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => idBorrando = fila.Tipo.Id">Borrar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Fila>? tipos;
    private TipoReserva? edicion;
    private bool esNuevo;
    private long? idBorrando;
    private string? error;
    private string? mensajeExito;

    private string ordenCampo = "orden";
    private bool ordenDescendente;

    private List<Fila> Ordenados
    {
        get
        {
            if (tipos is null)
            {
                return new List<Fila>();
            }

            Func<Fila, object?> clave = ordenCampo switch
            {
                "reservas" => f => f.NumeroReservas,
                "descripcion" => f => f.Tipo.Descripcion,
                _ => f => f.Tipo.Orden,
            };

            IEnumerable<Fila> resultado = ordenDescendente
                ? tipos.OrderByDescending(clave)
                : tipos.OrderBy(clave);

            return resultado.ToList();
        }
    }

    private void Ordenar(string campo)
    {
        if (ordenCampo == campo)
        {
            ordenDescendente = !ordenDescendente;
        }
        else
        {
            ordenCampo = campo;
            ordenDescendente = false;
        }
    }

    private string Flecha(string campo) =>
        ordenCampo != campo ? string.Empty : ordenDescendente ? " ▼" : " ▲";

    protected override Task OnInitializedAsync() => Cargar();

    private async Task Cargar()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            tipos = await db.TiposReserva
                .AsNoTracking()
                .OrderBy(t => t.Descripcion)
                .Select(t => new Fila(t, t.Reservas.Count))
                .ToListAsync();

            error = null;
        }
        catch (Exception ex)
        {
            tipos ??= new List<Fila>();
            error = ex.Message;
        }
    }

    private void Nuevo()
    {
        edicion = new TipoReserva();
        esNuevo = true;
        idBorrando = null;
        mensajeExito = null;
    }

    private void Editar(TipoReserva tipo)
    {
        edicion = new TipoReserva
        {
            Id = tipo.Id,
            Descripcion = tipo.Descripcion,
            HoraInicio = tipo.HoraInicio,
            HoraFin = tipo.HoraFin,
            Orden = tipo.Orden,
        };
        esNuevo = false;
        idBorrando = null;
    }

    private void Cancelar() => edicion = null;

    private async Task Guardar()
    {
        if (edicion is null)
        {
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            if (esNuevo)
            {
                db.TiposReserva.Add(edicion);
            }
            else
            {
                db.TiposReserva.Update(edicion);
            }

            await db.SaveChangesAsync();
            mensajeExito = esNuevo ? "Tipo de reserva creado." : "Tipo de reserva actualizado.";
            edicion = null;
            await Cargar();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task Borrar(long id)
    {
        idBorrando = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            await db.TiposReserva.Where(t => t.Id == id).ExecuteDeleteAsync();
            await Cargar();
        }
        catch (Exception ex)
        {
            error = $"No se pudo borrar el tipo (puede tener reservas asociadas): {ex.Message}";
        }
    }

    private record Fila(TipoReserva Tipo, int NumeroReservas);
}
