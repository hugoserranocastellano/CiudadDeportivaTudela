@page "/documentos"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject SupabaseStorageService Storage

<PageTitle>Documentos</PageTitle>

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <a class="btn btn-outline-secondary btn-sm" href="inicio">← Volver</a>
    <h1 class="mb-0 text-center flex-grow-1">Documentos</h1>
    @if (esJunta)
    {
        <button class="btn btn-pena" @onclick="Nuevo">Nuevo documento</button>
    }
</div>

@if (mensajeExito is not null)
{
    <div class="alert alert-success py-2">@mensajeExito</div>
}

@if (error is not null)
{
    <div class="alert alert-danger" role="alert"><code>@error</code></div>
}

@if (esJunta && edicion is not null)
{
    <div class="card mb-4">
        <div class="card-header fw-semibold">Nuevo documento</div>
        <div class="card-body">
            @if (errorForm is not null)
            {
                <div class="alert alert-danger py-2">@errorForm</div>
            }
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Título</label>
                    <input class="form-control" @bind="edicion.Titulo" @bind:event="oninput" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Fecha de validez</label>
                    <input type="date" class="form-control" value="@edicion.FechaValidez?.ToString("yyyy-MM-dd")"
                           @onchange="e => edicion.FechaValidez = DateOnly.TryParse(e.Value?.ToString(), out var f) ? f : null" />
                    <div class="form-text">Opcional: hasta cuándo es válido este documento.</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Fichero</label>
                    <InputFile class="form-control" OnChange="ElegirFichero" disabled="@subiendo" />
                    @if (subiendo)
                    {
                        <p class="text-muted small mb-0">Subiendo...</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(edicion.Url))
                    {
                        <p class="text-success small mb-0">Fichero subido.</p>
                    }
                </div>
            </div>
        </div>
        <div class="card-footer d-flex gap-2">
            <button type="button" class="btn btn-pena" disabled="@subiendo" @onclick="Guardar">Guardar</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancelar">Cancelar</button>
        </div>
    </div>
}

@if (documentos is null)
{
    <p><em>Cargando...</em></p>
}
else if (documentos.Count == 0)
{
    <p><em>No hay documentos todavía.</em></p>
}
else
{
    <div class="table-responsive tabla-marco">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Vigencia</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doc in documentos)
                {
                    <tr>
                        <td>@doc.Titulo</td>
                        <td>@(doc.FechaValidez?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" href="@doc.Url" target="_blank">Ver / descargar</a>
                            @if (esJunta)
                            {
                                @if (idBorrando == doc.Id)
                                {
                                    <button class="btn btn-sm btn-danger" @onclick="() => Borrar(doc.Id)">Confirmar</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => idBorrando = null">No</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => idBorrando = doc.Id">Borrar</button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    private bool esJunta;
    private List<DocumentoOficial>? documentos;
    private DocumentoOficial? edicion;
    private long? idBorrando;
    private bool subiendo;
    private string? error;
    private string? errorForm;
    private string? mensajeExito;

    protected override async Task OnInitializedAsync()
    {
        if (EstadoAutenticacion is not null)
        {
            var estado = await EstadoAutenticacion;
            esJunta = SocioAuth.EsJunta(estado.User);
        }

        await Cargar();
    }

    private async Task Cargar()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            documentos = await db.DocumentosOficiales
                .AsNoTracking()
                .OrderByDescending(d => d.FechaValidez)
                .ThenBy(d => d.Titulo)
                .ToListAsync();

            error = null;
        }
        catch (Exception ex)
        {
            documentos ??= new List<DocumentoOficial>();
            error = ex.Message;
        }
    }

    private void Nuevo()
    {
        edicion = new DocumentoOficial();
        idBorrando = null;
        errorForm = null;
        mensajeExito = null;
    }

    private void Cancelar() => edicion = null;

    private async Task ElegirFichero(InputFileChangeEventArgs e)
    {
        if (edicion is null)
        {
            return;
        }

        subiendo = true;
        errorForm = null;
        try
        {
            var fichero = e.File;
            var extension = Path.GetExtension(fichero.Name);
            var ruta = $"{Guid.NewGuid():N}{extension}";

            await using var stream = fichero.OpenReadStream(20 * 1024 * 1024);
            edicion.Url = await Storage.SubirAsync("estatutos", ruta, stream,
                string.IsNullOrWhiteSpace(fichero.ContentType) ? "application/octet-stream" : fichero.ContentType);
        }
        catch (Exception ex)
        {
            errorForm = ex.Message;
        }
        finally
        {
            subiendo = false;
        }
    }

    private async Task Guardar()
    {
        if (edicion is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(edicion.Titulo))
        {
            errorForm = "Indica un título.";
            return;
        }

        if (string.IsNullOrWhiteSpace(edicion.Url))
        {
            errorForm = "Sube primero el fichero.";
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            db.DocumentosOficiales.Add(edicion);
            await db.SaveChangesAsync();

            mensajeExito = "Documento creado.";
            error = null;
            edicion = null;
            await Cargar();
        }
        catch (Exception ex)
        {
            errorForm = ex.InnerException?.Message ?? ex.Message;
        }
    }

    private async Task Borrar(long id)
    {
        idBorrando = null;

        try
        {
            var doc = documentos?.FirstOrDefault(d => d.Id == id);

            await using var db = await DbFactory.CreateDbContextAsync();
            await db.DocumentosOficiales.Where(d => d.Id == id).ExecuteDeleteAsync();

            if (doc is not null)
            {
                await BorrarDeStorageSiPropio(doc.Url);
            }

            await Cargar();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task BorrarDeStorageSiPropio(string url)
    {
        var marcador = "/object/public/estatutos/";
        var indice = url.IndexOf(marcador, StringComparison.Ordinal);
        if (indice < 0)
        {
            return;
        }

        var ruta = url[(indice + marcador.Length)..];
        await Storage.BorrarAsync("estatutos", ruta);
    }
}
