@page "/articulos"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JS

<PageTitle>Artículos</PageTitle>
<JuntaGuard />

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <a class="btn btn-outline-secondary btn-sm" href="inicio">← Volver</a>
    <h1 class="mb-0 text-center flex-grow-1">Artículos</h1>
    <button class="btn btn-pena" @onclick="Nuevo">Nuevo artículo</button>
</div>

@if (mensajeExito is not null)
{
    <div class="alert alert-success py-2">@mensajeExito</div>
}

@if (error is not null)
{
    <div class="alert alert-danger" role="alert"><code>@error</code></div>
}

@if (edicion is not null)
{
    <EditForm Model="edicion" OnValidSubmit="Guardar" class="card mb-4">
        <DataAnnotationsValidator />
        <div class="card-header fw-semibold">@(esNuevo ? "Nuevo artículo" : $"Editar «{edicion.Descripcion}»")</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label">Descripción</label>
                    <InputText class="form-control" @bind-Value="edicion.Descripcion" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Proveedor</label>
                    <InputText class="form-control" @bind-Value="edicion.Proveedor" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Precio unidad (€)</label>
                    <InputNumber class="form-control" step="0.01" @bind-Value="edicion.PrecioUnidad" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Stock inicial</label>
                    <InputNumber class="form-control" @bind-Value="edicion.StockInicial" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Stock actual</label>
                    <InputNumber class="form-control" @bind-Value="edicion.StockActual" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Stock mínimo</label>
                    <InputNumber class="form-control" @bind-Value="edicion.StockMinimo" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Foto</label>
                    @if (esNuevo)
                    {
                        <div class="form-text">Guarda primero el artículo para poder subir su foto.</div>
                    }
                    else
                    {
                        <FotoCropper Bucket="Articulos" Path="@edicion.Id.ToString()" FotoActualUrl="@edicion.UrlFoto"
                                     FotoSubida="@(url => edicion.UrlFoto = url)"
                                     FotoBorrada="() => BorrarFoto(edicion.Id)" />
                    }
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <div class="form-check">
                        <InputCheckbox class="form-check-input" @bind-Value="activo" id="artActivo" />
                        <label class="form-check-label" for="artActivo">Activo</label>
                    </div>
                </div>
            </div>
            <ValidationSummary class="mt-3 small" />
        </div>
        <div class="card-footer d-flex gap-2">
            <button type="submit" class="btn btn-pena">Guardar</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancelar">Cancelar</button>
            @if (!esNuevo)
            {
                @if (idBorrando == edicion.Id)
                {
                    <button type="button" class="btn btn-danger ms-auto" @onclick="() => Borrar(edicion.Id)">Confirmar borrado</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => idBorrando = null">No</button>
                }
                else
                {
                    <button type="button" class="btn btn-outline-danger ms-auto" @onclick="() => idBorrando = edicion.Id">Borrar artículo</button>
                }
            }
        </div>
    </EditForm>
}

@if (articulos is not null && articulos.Count > 0)
{
    <div class="mb-3" style="max-width: 22rem;">
        <input class="form-control" placeholder="Buscar por descripción o proveedor"
               value="@filtro" @oninput="e => filtro = e.Value?.ToString() ?? string.Empty" />
    </div>
}

@if (articulos is null)
{
    <p><em>Cargando...</em></p>
}
else if (articulos.Count == 0)
{
    <p><em>No hay artículos todavía.</em></p>
}
else if (Filtrados.Count == 0)
{
    <p><em>No hay artículos que coincidan.</em></p>
}
else
{
    <p class="text-muted">@Filtrados.Count de @articulos.Count artículo(s), @(articulos.Count(BajoMinimo)) bajo mínimo.</p>

    <div class="table-responsive tabla-marco">
        <table class="table table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th>Foto</th>
                    <th role="button" @onclick='() => Ordenar("descripcion")'>Descripción@(Flecha("descripcion"))</th>
                    <th class="text-end" role="button" @onclick='() => Ordenar("precio")'>Precio@(Flecha("precio"))</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var articulo in Ordenados)
                {
                    <tr class="@(BajoMinimo(articulo) ? "table-warning" : null)">
                        <td>
                            @if (!string.IsNullOrWhiteSpace(articulo.UrlFoto))
                            {
                                <img src="@articulo.UrlFoto" alt="@articulo.Descripcion" style="width:40px;height:40px;object-fit:cover;" class="rounded" />
                            }
                        </td>
                        <td>@articulo.Descripcion</td>
                        <td class="text-end">@articulo.PrecioUnidad.ToString("N2") €</td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-accion-icono" title="Editar" @onclick="() => Editar(articulo)">Ed.</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Articulo>? articulos;
    private Articulo? edicion;
    private bool esNuevo;
    private bool activo = true;
    private long? idBorrando;
    private string filtro = string.Empty;
    private string? error;
    private string? mensajeExito;

    private string ordenCampo = "descripcion";
    private bool ordenDescendente;

    private static bool BajoMinimo(Articulo a) => a.StockActual <= a.StockMinimo;

    private List<Articulo> Filtrados
    {
        get
        {
            if (articulos is null)
            {
                return new List<Articulo>();
            }

            if (string.IsNullOrWhiteSpace(filtro))
            {
                return articulos;
            }

            var texto = filtro.Trim();

            return articulos
                .Where(a => a.Descripcion.Contains(texto, StringComparison.OrdinalIgnoreCase)
                    || (a.Proveedor?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();
        }
    }

    private List<Articulo> Ordenados
    {
        get
        {
            var filtrados = Filtrados;

            Func<Articulo, object?> clave = ordenCampo switch
            {
                "proveedor" => a => a.Proveedor,
                "precio" => a => a.PrecioUnidad,
                "stock" => a => a.StockActual,
                "minimo" => a => a.StockMinimo,
                "activo" => a => a.Activo,
                _ => a => a.Descripcion,
            };

            IEnumerable<Articulo> resultado = ordenDescendente
                ? filtrados.OrderByDescending(clave)
                : filtrados.OrderBy(clave);

            return resultado.ToList();
        }
    }

    private void Ordenar(string campo)
    {
        if (ordenCampo == campo)
        {
            ordenDescendente = !ordenDescendente;
        }
        else
        {
            ordenCampo = campo;
            ordenDescendente = false;
        }
    }

    private string Flecha(string campo) =>
        ordenCampo != campo ? string.Empty : ordenDescendente ? " ▼" : " ▲";

    protected override Task OnInitializedAsync() => Cargar();

    private async Task Cargar()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            articulos = await db.Articulos
                .AsNoTracking()
                .OrderBy(a => a.Descripcion)
                .ToListAsync();

            error = null;
        }
        catch (Exception ex)
        {
            articulos ??= new List<Articulo>();
            error = ex.Message;
        }
    }

    private void Nuevo()
    {
        edicion = new Articulo();
        activo = true;
        esNuevo = true;
        idBorrando = null;
        mensajeExito = null;
    }

    private async Task Editar(Articulo articulo)
    {
        edicion = new Articulo
        {
            Id = articulo.Id,
            Descripcion = articulo.Descripcion,
            UrlFoto = articulo.UrlFoto,
            PrecioUnidad = articulo.PrecioUnidad,
            Proveedor = articulo.Proveedor,
            StockInicial = articulo.StockInicial,
            StockActual = articulo.StockActual,
            StockMinimo = articulo.StockMinimo,
            Activo = articulo.Activo,
        };
        activo = articulo.Activo != false;
        esNuevo = false;
        idBorrando = null;
        mensajeExito = null;
        await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
    }

    private void Cancelar() => edicion = null;

    private async Task BorrarFoto(long id)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await db.Articulos.Where(a => a.Id == id).ExecuteUpdateAsync(a => a.SetProperty(x => x.UrlFoto, (string?)null));

            if (edicion?.Id == id)
            {
                edicion.UrlFoto = null;
            }

            await Cargar();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task Guardar()
    {
        if (edicion is null)
        {
            return;
        }

        edicion.Activo = activo;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            if (esNuevo)
            {
                db.Articulos.Add(edicion);
            }
            else
            {
                db.Articulos.Update(edicion);
            }

            await db.SaveChangesAsync();
            mensajeExito = esNuevo ? "Artículo creado." : "Artículo actualizado.";
            error = null;
            edicion = null;
            await Cargar();
        }
        catch (Exception ex)
        {
            error = ex.InnerException?.Message ?? ex.Message;
        }
    }

    private async Task Borrar(long id)
    {
        idBorrando = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            await db.Articulos.Where(a => a.Id == id).ExecuteDeleteAsync();
            edicion = null;
            await Cargar();
        }
        catch (Exception ex)
        {
            error = $"No se pudo borrar el artículo (puede estar en tickets o movimientos de stock): {ex.Message}";
        }
    }
}
