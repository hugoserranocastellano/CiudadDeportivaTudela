@page "/socios"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IConfiguration Configuration
@inject IJSRuntime JS

<PageTitle>Socios</PageTitle>
<JuntaGuard />

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <a class="btn btn-outline-secondary btn-sm" href="inicio">← Volver</a>
    <h1 class="mb-0 text-center flex-grow-1">Socios</h1>
    <button class="btn btn-pena" @onclick="Nuevo">Nuevo socio</button>
</div>

@if (mensajeExito is not null)
{
    <div class="alert alert-success py-2">@mensajeExito</div>
}

@if (error is not null)
{
    <div class="alert alert-danger" role="alert">
        <h5 class="alert-heading">No se pudo completar la operación</h5>
        <p class="mb-0"><code>@error</code></p>
        @if (diagnostico is not null)
        {
            <hr />
            <p class="mb-0"><small>Parámetros de conexión: <code>@diagnostico</code></small></p>
        }
    </div>
}

@if (edicion is not null)
{
    <EditForm Model="edicion" OnValidSubmit="Guardar" class="card mb-4">
        <DataAnnotationsValidator />
        <div class="card-header fw-semibold">@(esNuevo ? "Nuevo socio" : $"Editar socio: {edicion.Nombre}")</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">DNI</label>
                    <InputText class="form-control" @bind-Value="edicion.Dni" />
                    <div class="form-text">Es también su usuario de acceso (sin la letra).</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Nombre</label>
                    <InputText class="form-control" @bind-Value="edicion.Nombre" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Apellidos</label>
                    <InputText class="form-control" @bind-Value="edicion.Apellidos" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Teléfono</label>
                    <InputText class="form-control" @bind-Value="edicion.Telefono" />
                    <div class="form-text">Es también su usuario de acceso (PIN = sus 4 últimos dígitos).</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Email</label>
                    <InputText class="form-control" @bind-Value="edicion.Email" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Dirección</label>
                    <InputText class="form-control" @bind-Value="edicion.Direccion" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Categoría</label>
                    <InputSelect class="form-select" @bind-Value="edicion.CategoriaId">
                        <option value="">(sin categoría)</option>
                        @foreach (var c in categorias)
                        {
                            <option value="@c.Id">@c.TipoSocio (junta: @c.Junta)</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Nº de cuenta</label>
                    <InputText class="form-control" @bind-Value="edicion.NumeroCuenta" />
                </div>
                @if (!esNuevo)
                {
                    <div class="col-md-4">
                        <label class="form-label">PIN de acceso</label>
                        <div class="input-group">
                            <input class="form-control" maxlength="4" inputmode="numeric" placeholder="4 dígitos"
                                   value="@nuevoPin" @oninput="e => nuevoPin = e.Value?.ToString() ?? string.Empty" />
                            <button type="button" class="btn btn-outline-secondary"
                                    @onclick="() => nuevoPin = SocioAuth.SoloDigitos(edicion!.Telefono) is var d && d.Length >= 4 ? d[^4..] : string.Empty">
                                Usar últimos 4 del teléfono
                            </button>
                        </div>
                        <div class="form-text">Déjalo en blanco para no cambiarlo. No hace falta el PIN antiguo.</div>
                        @if (!string.IsNullOrEmpty(nuevoPin) && !SocioAuth.PinValido(nuevoPin))
                        {
                            <div class="text-danger small">El PIN debe tener exactamente 4 dígitos.</div>
                        }
                    </div>
                }
                <div class="col-md-4">
                    <label class="form-label">Foto</label>
                    @if (esNuevo)
                    {
                        <div class="form-text">Guarda primero el socio para poder subir su foto.</div>
                    }
                    else
                    {
                        <FotoCropper Bucket="Socios" Path="@edicion.Id.ToString()" FotoActualUrl="@edicion.UrlFoto"
                                     FotoSubida="@(url => edicion.UrlFoto = url)"
                                     FotoBorrada="() => BorrarFoto(edicion.Id)" />
                    }
                </div>
                <div class="col-md-2">
                    <label class="form-label">Fecha de alta</label>
                    <InputDate class="form-control" @bind-Value="edicion.FechaAlta" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <div class="form-check">
                        <InputCheckbox class="form-check-input" @bind-Value="activo" id="socioActivo" />
                        <label class="form-check-label" for="socioActivo">Activo</label>
                    </div>
                </div>
            </div>
            <ValidationSummary class="mt-3 small" />
        </div>
        <div class="card-footer d-flex gap-2">
            <button type="submit" class="btn btn-pena">Guardar</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancelar">Cancelar</button>
            @if (!esNuevo)
            {
                @if (idBorrando == edicion.Id)
                {
                    <button type="button" class="btn btn-danger ms-auto" @onclick="() => Borrar(edicion.Id)">Confirmar borrado</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => idBorrando = null">No</button>
                }
                else
                {
                    <button type="button" class="btn btn-outline-danger ms-auto" @onclick="() => idBorrando = edicion.Id">Borrar socio</button>
                }
            }
        </div>
    </EditForm>
}

<div class="mb-3" style="max-width: 22rem;">
    <input class="form-control" placeholder="Buscar por DNI, nombre, apellidos, teléfono, email o dirección"
           value="@filtro" @oninput="e => filtro = e.Value?.ToString() ?? string.Empty" />
</div>

@if (socios is null)
{
    <p><em>Cargando...</em></p>
}
else if (Filtrados.Count == 0)
{
    <p><em>No hay socios que coincidan.</em></p>
}
else
{
    <p class="text-muted">@Filtrados.Count de @socios.Count socio(s).</p>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Foto</th>
                    <th role="button" @onclick='() => Ordenar("nombre")'>Nombre@(Flecha("nombre"))</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var socio in Filtrados)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(socio.UrlFoto))
                            {
                                <img src="@socio.UrlFoto" alt="@socio.Nombre" style="width:36px;height:36px;object-fit:cover;" class="rounded-circle" />
                            }
                        </td>
                        <td>@socio.Nombre @socio.Apellidos</td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-accion-icono" title="Editar" @onclick="() => Editar(socio)">Ed.</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Socio>? socios;
    private List<CategoriaSocio> categorias = new();
    private Socio? edicion;
    private bool esNuevo;
    private bool activo = true;
    private string nuevoPin = string.Empty;
    private long? idBorrando;
    private string filtro = string.Empty;
    private string? error;
    private string? diagnostico;
    private string? mensajeExito;

    private string ordenCampo = "nombre";
    private bool ordenDescendente;

    private List<Socio> Filtrados
    {
        get
        {
            if (socios is null)
            {
                return new List<Socio>();
            }

            IEnumerable<Socio> resultado = socios;

            if (!string.IsNullOrWhiteSpace(filtro))
            {
                var texto = filtro.Trim();

                resultado = resultado.Where(s =>
                    (s.Dni?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false)
                    || s.Nombre.Contains(texto, StringComparison.OrdinalIgnoreCase)
                    || (s.Apellidos?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (s.Direccion?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (s.Telefono?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (s.Email?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            Func<Socio, object?> clave = ordenCampo switch
            {
                "dni" => s => s.Dni,
                "apellidos" => s => s.Apellidos,
                "direccion" => s => s.Direccion,
                "categoria" => s => s.CategoriaSocio?.TipoSocio,
                "telefono" => s => s.Telefono,
                "email" => s => s.Email,
                "alta" => s => s.FechaAlta,
                "ultimoAcceso" => s => s.UltimoAcceso,
                "validezPin" => s => s.ValidezPin,
                "activo" => s => s.Activo,
                _ => s => s.Nombre,
            };

            resultado = ordenDescendente
                ? resultado.OrderByDescending(clave)
                : resultado.OrderBy(clave);

            return resultado.ToList();
        }
    }

    private void Ordenar(string campo)
    {
        if (ordenCampo == campo)
        {
            ordenDescendente = !ordenDescendente;
        }
        else
        {
            ordenCampo = campo;
            ordenDescendente = false;
        }
    }

    private string Flecha(string campo) =>
        ordenCampo != campo ? string.Empty : ordenDescendente ? " ▼" : " ▲";

    protected override Task OnInitializedAsync() => Cargar();

    private async Task Cargar()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            socios = await db.Socios
                .AsNoTracking()
                .Include(s => s.CategoriaSocio)
                .OrderBy(s => s.Nombre)
                .ToListAsync();

            categorias = await db.CategoriasSocios.AsNoTracking().ToListAsync();

            error = null;
            diagnostico = null;
        }
        catch (Exception ex)
        {
            socios ??= new List<Socio>();
            error = ex.InnerException?.Message ?? ex.Message;
            DescribirConexion();
        }
    }

    private void Nuevo()
    {
        edicion = new Socio
        {
            FechaAlta = DateTime.Today,
        };
        activo = true;
        esNuevo = true;
        nuevoPin = string.Empty;
        idBorrando = null;
        mensajeExito = null;
    }

    private async Task Editar(Socio socio)
    {
        // Copia para que cancelar no deje la fila de la tabla a medio editar.
        edicion = new Socio
        {
            Id = socio.Id,
            Dni = socio.Dni,
            Nombre = socio.Nombre,
            Apellidos = socio.Apellidos,
            Direccion = socio.Direccion,
            Telefono = socio.Telefono,
            Email = socio.Email,
            UrlFoto = socio.UrlFoto,
            PinHash = socio.PinHash,
            CategoriaId = socio.CategoriaId,
            NumeroCuenta = socio.NumeroCuenta,
            Activo = socio.Activo,
            FechaAlta = socio.FechaAlta,
        };
        activo = socio.Activo != false;
        esNuevo = false;
        nuevoPin = string.Empty;
        idBorrando = null;
        mensajeExito = null;
        await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
    }

    private void Cancelar() => edicion = null;

    private async Task BorrarFoto(long id)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await db.Socios.Where(s => s.Id == id).ExecuteUpdateAsync(s => s.SetProperty(x => x.UrlFoto, (string?)null));

            if (edicion?.Id == id)
            {
                edicion.UrlFoto = null;
            }

            await Cargar();
        }
        catch (Exception ex)
        {
            error = ex.InnerException?.Message ?? ex.Message;
        }
    }

    private async Task Guardar()
    {
        if (edicion is null)
        {
            return;
        }

        edicion.Activo = activo;

        // Npgsql exige Kind=Utc para columnas timestamptz; InputDate/DateTime.Today
        // devuelven Kind=Unspecified y el guardado falla en silencio (mensaje opaco de EF).
        if (edicion.FechaAlta is DateTime fechaAlta && fechaAlta.Kind != DateTimeKind.Utc)
        {
            edicion.FechaAlta = DateTime.SpecifyKind(fechaAlta, DateTimeKind.Utc);
        }

        if (!esNuevo && !string.IsNullOrEmpty(nuevoPin))
        {
            if (!SocioAuth.PinValido(nuevoPin))
            {
                error = "El PIN debe tener exactamente 4 dígitos.";
                return;
            }

            edicion.PinHash = long.Parse(nuevoPin);
            edicion.ValidezPin = DateTime.UtcNow;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            if (esNuevo)
            {
                // El PIN de acceso se siembra con los últimos 4 dígitos del teléfono;
                // el socio lo puede cambiar luego desde su perfil.
                if (edicion.PinHash is null)
                {
                    var digitos = SocioAuth.SoloDigitos(edicion.Telefono);
                    if (digitos.Length >= 4 && long.TryParse(digitos[^4..], out var pinInicial))
                    {
                        edicion.PinHash = pinInicial;
                        edicion.ValidezPin = DateTime.UtcNow;
                    }
                }

                db.Socios.Add(edicion);
            }
            else
            {
                db.Socios.Update(edicion);
            }

            await db.SaveChangesAsync();
            mensajeExito = esNuevo ? "Socio creado." : "Socio actualizado.";
            error = null;
            diagnostico = null;
            edicion = null;
            await Cargar();
        }
        catch (Exception ex)
        {
            error = ex.InnerException?.Message ?? ex.Message;
            DescribirConexion();
        }
    }

    private async Task Borrar(long id)
    {
        idBorrando = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            await db.Socios.Where(s => s.Id == id).ExecuteDeleteAsync();
            edicion = null;
            await Cargar();
        }
        catch (Exception ex)
        {
            error = $"No se pudo borrar el socio (puede tener tickets o reservas asociados): {ex.Message}";
        }
    }

    // Un 28P01 no dice qué usuario/host se usó. Mostrarlo aquí (sin la contraseña)
    // evita tener que adivinar a base de despliegues.
    private void DescribirConexion()
    {
        try
        {
            var raw = Configuration.GetConnectionString("Supabase");
            diagnostico = string.IsNullOrWhiteSpace(raw)
                ? null
                : PostgresConnectionString.Describe(PostgresConnectionString.Normalize(raw));
        }
        catch (Exception diagEx)
        {
            diagnostico = diagEx.Message;
        }
    }
}
