@page "/reserva-mesas"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Mesas por reserva</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">Mesas por reserva</h1>
    <button class="btn btn-pena" @onclick="Nuevo">Asignar mesa</button>
</div>

<p class="text-muted">Qué mesas ocupa cada reserva del comedor.</p>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert"><code>@error</code></div>
}

@if (edicion is not null)
{
    <EditForm Model="edicion" OnValidSubmit="Guardar" class="card mb-4">
        <div class="card-header fw-semibold">@(esNuevo ? "Asignar mesa a una reserva" : "Editar asignación")</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Reserva</label>
                    <InputSelect class="form-select" @bind-Value="edicion.ReservaId">
                        <option value="">(elige una reserva)</option>
                        @foreach (var reserva in reservas)
                        {
                            <option value="@reserva.Id">@reserva.Texto</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Mesa</label>
                    <InputSelect class="form-select" @bind-Value="edicion.MesaId">
                        <option value="">(elige una mesa)</option>
                        @foreach (var mesa in mesas)
                        {
                            <option value="@mesa.Id">@mesa.Texto</option>
                        }
                    </InputSelect>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex gap-2">
            <button type="submit" class="btn btn-pena">Guardar</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancelar">Cancelar</button>
        </div>
    </EditForm>
}

@if (asignaciones is null)
{
    <p><em>Cargando...</em></p>
}
else if (asignaciones.Count == 0)
{
    <p><em>No hay mesas asignadas todavía.</em></p>
}
else
{
    <p class="text-muted">@asignaciones.Count asignación(es).</p>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Reserva</th>
                    <th>Mesa</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fila in asignaciones)
                {
                    <tr>
                        <td>@fila.Id</td>
                        <td>@Texto(reservasPorId, fila.ReservaId)</td>
                        <td>@Texto(mesasPorId, fila.MesaId)</td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Editar(fila.Id)">Editar</button>
                            @if (idBorrando == fila.Id)
                            {
                                <button class="btn btn-sm btn-danger" @onclick="() => Borrar(fila.Id)">Confirmar</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => idBorrando = null">No</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => idBorrando = fila.Id">Quitar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Fila>? asignaciones;
    private List<Opcion> reservas = new();
    private List<Opcion> mesas = new();
    private Dictionary<long, string> reservasPorId = new();
    private Dictionary<long, string> mesasPorId = new();
    private ReservaMesa? edicion;
    private bool esNuevo;
    private long? idBorrando;
    private string? error;

    private static string Texto(Dictionary<long, string> indice, long? id) =>
        id is not null && indice.TryGetValue(id.Value, out var texto) ? texto : "—";

    protected override Task OnInitializedAsync() => Cargar();

    private async Task Cargar()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            reservas = (await db.Reservas
                    .AsNoTracking()
                    .OrderByDescending(r => r.Fecha)
                    .Select(r => new { r.Id, r.Fecha, r.TipoReserva, r.Comensales })
                    .ToListAsync())
                .Select(r => new Opcion(
                    r.Id,
                    $"#{r.Id} · {r.Fecha.ToShortDateString()} · {r.TipoReserva} · {r.Comensales} pax"))
                .ToList();

            mesas = (await db.Mesas
                    .AsNoTracking()
                    .OrderBy(m => m.Estancia)
                    .ThenBy(m => m.Descripcion)
                    .Select(m => new { m.Id, m.Descripcion, m.Estancia, m.Capacidad, m.Activa })
                    .ToListAsync())
                .Select(m => new Opcion(
                    m.Id,
                    $"{m.Descripcion} ({m.Estancia}, {m.Capacidad} pax)"))
                .ToList();

            reservasPorId = reservas.ToDictionary(r => r.Id, r => r.Texto);
            mesasPorId = mesas.ToDictionary(m => m.Id, m => m.Texto);

            asignaciones = await db.ReservaMesas
                .AsNoTracking()
                .OrderByDescending(rm => rm.Id)
                .Select(rm => new Fila(rm.Id, rm.ReservaId, rm.MesaId))
                .ToListAsync();

            error = null;
        }
        catch (Exception ex)
        {
            asignaciones ??= new List<Fila>();
            error = ex.Message;
        }
    }

    private void Nuevo()
    {
        edicion = new ReservaMesa();
        esNuevo = true;
        idBorrando = null;
    }

    private async Task Editar(long id)
    {
        idBorrando = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            edicion = await db.ReservaMesas.AsNoTracking().FirstOrDefaultAsync(rm => rm.Id == id);
            esNuevo = false;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private void Cancelar() => edicion = null;

    private async Task Guardar()
    {
        if (edicion is null)
        {
            return;
        }

        if (edicion.ReservaId is null || edicion.MesaId is null)
        {
            error = "Hay que elegir una reserva y una mesa.";
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            if (esNuevo)
            {
                db.ReservaMesas.Add(edicion);
            }
            else
            {
                db.ReservaMesas.Update(edicion);
            }

            await db.SaveChangesAsync();
            edicion = null;
            await Cargar();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task Borrar(long id)
    {
        idBorrando = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            await db.ReservaMesas.Where(rm => rm.Id == id).ExecuteDeleteAsync();
            await Cargar();
        }
        catch (Exception ex)
        {
            error = $"No se pudo quitar la asignación: {ex.Message}";
        }
    }

    private record Fila(long Id, long? ReservaId, long? MesaId);

    private record Opcion(long Id, string Texto);
}
