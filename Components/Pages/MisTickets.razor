@page "/mis-tickets"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Mis tickets</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-outline-secondary btn-sm" href="inicio">← Volver</a>
        <h1 class="mb-0">Mis tickets</h1>
    </div>
    <a class="btn btn-pena" href="tickets/nuevo">Nuevo ticket</a>
</div>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert"><code>@error</code></div>
}

@if (tickets is null)
{
    <p><em>Cargando...</em></p>
}
else if (tickets.Count == 0)
{
    <p><em>No tienes tickets registrados.</em></p>
}
else
{
    <p class="text-muted">
        @tickets.Count ticket(s), @(tickets.Where(t => t.Estado == "pagado").Sum(t => t.ImporteTotal ?? 0).ToString("N2")) € pagados en total.
    </p>

    <div class="tabla-marco">
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th role="button" @onclick='() => Ordenar("id")'>#@(Flecha("id"))</th>
                        <th role="button" @onclick='() => Ordenar("fecha")'>Fecha@(Flecha("fecha"))</th>
                        <th class="text-end" role="button" @onclick='() => Ordenar("importe")'>Importe@(Flecha("importe"))</th>
                        <th role="button" @onclick='() => Ordenar("estado")'>Estado@(Flecha("estado"))</th>
                        <th role="button" @onclick='() => Ordenar("lineas")'>Líneas@(Flecha("lineas"))</th>
                        <th>Foto</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in Ordenados)
                    {
                        @if (ticket.Estado == "abierto")
                        {
                            <tr>
                                <td>@ticket.Id</td>
                                <td>@ticket.Fecha?.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">@ticket.ImporteTotal?.ToString("0.00")€</td>
                                <td><span class="badge text-bg-warning">Pendiente</span></td>
                                <td>@ticket.NumeroLineas</td>
                                <td><a class="btn btn-sm btn-pena" href="tickets/nuevo">Continuar</a></td>
                            </tr>
                        }
                        else
                        {
                            <tr role="button" class="@(ticketSeleccionado == ticket.Id ? "table-primary fw-semibold" : null)"
                                style="@(ticketSeleccionado == ticket.Id ? "border-left: 4px solid var(--bs-primary);" : null)"
                                @onclick="() => Seleccionar(ticket.Id)">
                                <td>@ticket.Id</td>
                                <td>@ticket.Fecha?.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">@ticket.ImporteTotal?.ToString("0.00")€</td>
                                <td>
                                    <span class="badge text-bg-success">Pagado</span>
                                    @if (!string.IsNullOrWhiteSpace(ticket.FormaPago))
                                    {
                                        <span class="text-muted small">(@ticket.FormaPago)</span>
                                    }
                                </td>
                                <td>@ticket.NumeroLineas</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(ticket.UrlFotoTicket))
                                    {
                                        <button type="button" class="btn btn-sm btn-accion-icono" title="Ver foto del ticket"
                                                @onclick:stopPropagation="true" @onclick="() => ToggleFoto(ticket.Id)">
                                            Ver
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (fotoAbierta is not null)
    {
        var ticketFoto = tickets.First(t => t.Id == fotoAbierta);
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Ticket #@ticketFoto.Id</span>
                <button class="btn-close" @onclick="() => fotoAbierta = null" aria-label="Cerrar"></button>
            </div>
            <div class="card-body text-center">
                <img src="@ticketFoto.UrlFotoTicket" alt="Foto del ticket #@ticketFoto.Id" style="max-width:100%;max-height:70vh;" />
            </div>
        </div>
    }

    @if (ticketSeleccionado is not null)
    {
        <div class="card mb-3">
            <div class="card-body">
                @if (lineasCargando)
                {
                    <p class="mb-0"><em>Cargando detalle...</em></p>
                }
                else if (lineas is not null)
                {
                    @if (lineas.Count == 0)
                    {
                        <p class="mb-2"><em>Este ticket no tiene líneas.</em></p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm mb-2">
                                <thead>
                                    <tr>
                                        <th>Artículo</th>
                                        <th class="text-end">Precio unidad</th>
                                        <th class="text-end">Unidades</th>
                                        <th class="text-end">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var linea in lineas)
                                    {
                                        <tr>
                                            <td>@linea.Articulo</td>
                                            <td class="text-end">@linea.PrecioUnidad?.ToString("0.00")€</td>
                                            <td class="text-end">@linea.Unidades</td>
                                            <td class="text-end">@linea.Subtotal?.ToString("0.00")€</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    <button class="btn btn-sm btn-outline-secondary" @onclick="Deseleccionar">Volver</button>
                }
            </div>
        </div>
    }
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    private long? socioId;
    private List<Fila>? tickets;
    private long? ticketSeleccionado;
    private List<FilaLinea>? lineas;
    private bool lineasCargando;
    private string? error;
    private long? fotoAbierta;

    private void ToggleFoto(long ticketId) =>
        fotoAbierta = fotoAbierta == ticketId ? null : ticketId;

    private string ordenCampo = "fecha";
    private bool ordenDescendente = true;

    private List<Fila> Ordenados
    {
        get
        {
            if (tickets is null)
            {
                return new List<Fila>();
            }

            Func<Fila, object?> clave = ordenCampo switch
            {
                "id" => t => t.Id,
                "importe" => t => t.ImporteTotal,
                "estado" => t => t.Estado,
                "lineas" => t => t.NumeroLineas,
                _ => t => t.Fecha,
            };

            IEnumerable<Fila> resultado = ordenDescendente
                ? tickets.OrderByDescending(clave)
                : tickets.OrderBy(clave);

            return resultado.ToList();
        }
    }

    private void Ordenar(string campo)
    {
        if (ordenCampo == campo)
        {
            ordenDescendente = !ordenDescendente;
        }
        else
        {
            ordenCampo = campo;
            ordenDescendente = false;
        }
    }

    private string Flecha(string campo) =>
        ordenCampo != campo ? string.Empty : ordenDescendente ? " ▼" : " ▲";

    protected override async Task OnInitializedAsync()
    {
        if (EstadoAutenticacion is null)
        {
            return;
        }

        var estado = await EstadoAutenticacion;
        socioId = SocioAuth.SocioId(estado.User);

        await Cargar();
    }

    private async Task Cargar()
    {
        if (socioId is null)
        {
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            tickets = await db.Tickets
                .AsNoTracking()
                .Where(t => t.SocioId == socioId)
                .OrderByDescending(t => t.Fecha)
                .ThenByDescending(t => t.Id)
                .Select(t => new Fila(
                    t.Id,
                    t.Fecha,
                    t.ImporteTotal,
                    t.Estado,
                    t.FormaPago,
                    t.UrlFotoTicket,
                    t.Lineas.Count))
                .ToListAsync();

            error = null;
        }
        catch (Exception ex)
        {
            tickets ??= new List<Fila>();
            error = ex.Message;
        }
    }

    private async Task Seleccionar(long ticketId)
    {
        if (ticketSeleccionado == ticketId)
        {
            Deseleccionar();
            return;
        }

        ticketSeleccionado = ticketId;
        lineas = null;
        lineasCargando = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // socioId además de TicketId: no deja ver el detalle de un ticket ajeno
            // aunque se manipule el id seleccionado.
            lineas = await db.TicketLineas
                .AsNoTracking()
                .Where(l => l.TicketId == ticketId && l.Ticket!.SocioId == socioId)
                .Select(l => new FilaLinea(
                    l.Articulo!.Descripcion,
                    l.PrecioUnidad,
                    l.Unidades,
                    l.Subtotal))
                .ToListAsync();

            error = null;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            lineasCargando = false;
        }
    }

    private void Deseleccionar()
    {
        ticketSeleccionado = null;
        lineas = null;
    }

    private record Fila(
        long Id,
        DateTime? Fecha,
        decimal? ImporteTotal,
        string Estado,
        string? FormaPago,
        string? UrlFotoTicket,
        int NumeroLineas);

    private record FilaLinea(string Articulo, decimal? PrecioUnidad, int? Unidades, decimal? Subtotal);
}
