@page "/reservas"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Reservas</PageTitle>
<JuntaGuard />

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">Reservas</h1>
    <button class="btn btn-pena" @onclick="Nuevo">Nueva reserva</button>
</div>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert"><code>@error</code></div>
}

@if (edicion is not null)
{
    <EditForm Model="edicion" OnValidSubmit="Guardar" class="card mb-4">
        <DataAnnotationsValidator />
        <div class="card-header fw-semibold">@(esNuevo ? "Nueva reserva" : $"Editar reserva #{edicion.Id}")</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Fecha</label>
                    <InputDate class="form-control" @bind-Value="edicion.Fecha" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Socio</label>
                    <InputSelect class="form-select" @bind-Value="edicion.SocioId">
                        <option value="">(sin socio)</option>
                        @foreach (var socio in socios)
                        {
                            <option value="@socio.Id">@socio.Texto</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Comensales</label>
                    <InputNumber class="form-control" @bind-Value="edicion.Comensales" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Tipo de reserva</label>
                    <InputText class="form-control" list="tiposReserva" @bind-Value="edicion.TipoReserva" />
                    <datalist id="tiposReserva">
                        <option value="comida" />
                        <option value="cena" />
                        <option value="almuerzo" />
                        <option value="celebración" />
                    </datalist>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Estado</label>
                    <InputSelect class="form-select" @bind-Value="edicion.Estado">
                        <option value="activa">activa</option>
                        <option value="cancelada">cancelada</option>
                        <option value="cerrada">cerrada</option>
                    </InputSelect>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check">
                        <InputCheckbox class="form-check-input" @bind-Value="limpieza" id="resLimpieza" />
                        <label class="form-check-label" for="resLimpieza">Limpieza hecha</label>
                    </div>
                </div>
            </div>
            <ValidationSummary class="mt-3 small" />
        </div>
        <div class="card-footer d-flex gap-2">
            <button type="submit" class="btn btn-pena">Guardar</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancelar">Cancelar</button>
        </div>
    </EditForm>
}

@if (reservas is null)
{
    <p><em>Cargando...</em></p>
}
else if (reservas.Count == 0)
{
    <p><em>No hay reservas registradas.</em></p>
}
else
{
    <p class="text-muted">@reservas.Count reserva(s).</p>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Fecha</th>
                    <th>Socio</th>
                    <th class="text-end">Comensales</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>Limpieza</th>
                    <th>Mesas</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reserva in reservas)
                {
                    <tr>
                        <td>@reserva.Id</td>
                        <td>@reserva.Fecha.ToShortDateString()</td>
                        <td>@NombreSocio(reserva.SocioId)</td>
                        <td class="text-end">@reserva.Comensales</td>
                        <td>@reserva.TipoReserva</td>
                        <td>@reserva.Estado</td>
                        <td>@(reserva.Limpieza == true ? "Sí" : "No")</td>
                        <td>@(reserva.Mesas.Count == 0 ? "—" : string.Join(", ", reserva.Mesas))</td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Editar(reserva.Id)">Editar</button>
                            @if (idBorrando == reserva.Id)
                            {
                                <button class="btn btn-sm btn-danger" @onclick="() => Borrar(reserva.Id)">Confirmar</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => idBorrando = null">No</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => idBorrando = reserva.Id">Borrar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Fila>? reservas;
    private List<Opcion> socios = new();
    private Dictionary<long, string> nombresSocio = new();
    private Reserva? edicion;
    private bool esNuevo;
    private bool limpieza;
    private long? idBorrando;
    private string? error;

    // Los nombres se resuelven en memoria: así la consulta no arrastra joins ni
    // concatenaciones que Npgsql tendría que traducir.
    private string NombreSocio(long? id) =>
        id is not null && nombresSocio.TryGetValue(id.Value, out var nombre) ? nombre : "—";

    protected override Task OnInitializedAsync() => Cargar();

    private async Task Cargar()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            socios = (await db.Socios
                    .AsNoTracking()
                    .OrderBy(s => s.Nombre)
                    .Select(s => new { s.Id, s.Dni, s.Nombre, s.Apellidos })
                    .ToListAsync())
                .Select(s => new Opcion(s.Id, $"{s.Dni} · {s.Nombre} {s.Apellidos}".TrimEnd()))
                .ToList();

            nombresSocio = socios.ToDictionary(s => s.Id, s => s.Texto);

            reservas = await db.Reservas
                .AsNoTracking()
                .OrderByDescending(r => r.Fecha)
                .ThenByDescending(r => r.Id)
                .Select(r => new Fila(
                    r.Id,
                    r.Fecha,
                    r.SocioId,
                    r.Comensales,
                    r.TipoReserva,
                    r.Estado,
                    r.Limpieza,
                    r.ReservaMesas.Select(rm => rm.Mesa!.Descripcion).ToList()))
                .ToListAsync();

            error = null;
        }
        catch (Exception ex)
        {
            reservas ??= new List<Fila>();
            error = ex.Message;
        }
    }

    private void Nuevo()
    {
        edicion = new Reserva();
        limpieza = false;
        esNuevo = true;
        idBorrando = null;
    }

    private async Task Editar(long id)
    {
        idBorrando = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // Sin Include: al guardar sólo debe viajar la reserva, no el socio.
            edicion = await db.Reservas.AsNoTracking().FirstOrDefaultAsync(r => r.Id == id);
            limpieza = edicion?.Limpieza == true;
            esNuevo = false;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private void Cancelar() => edicion = null;

    private async Task Guardar()
    {
        if (edicion is null)
        {
            return;
        }

        edicion.Limpieza = limpieza;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            if (esNuevo)
            {
                db.Reservas.Add(edicion);
            }
            else
            {
                db.Reservas.Update(edicion);
            }

            await db.SaveChangesAsync();
            edicion = null;
            await Cargar();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task Borrar(long id)
    {
        idBorrando = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // reserva_mesas cae en cascada por la FK.
            await db.Reservas.Where(r => r.Id == id).ExecuteDeleteAsync();
            await Cargar();
        }
        catch (Exception ex)
        {
            error = $"No se pudo borrar la reserva: {ex.Message}";
        }
    }

    private record Fila(
        long Id,
        DateOnly Fecha,
        long? SocioId,
        int? Comensales,
        string? TipoReserva,
        string? Estado,
        bool? Limpieza,
        List<string> Mesas);

    private record Opcion(long Id, string Texto);
}
