@page "/reservas"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Globalization
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Reservas</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">Reservas</h1>
</div>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert"><code>@error</code></div>
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <button class="btn btn-outline-secondary" disabled="@(!PuedeRetroceder)" @onclick="MesAnterior">← Mes anterior</button>
    <h4 class="mb-0 text-capitalize">@mesActual.ToString("MMMM yyyy", CultureInfo.GetCultureInfo("es-ES"))</h4>
    <button class="btn btn-outline-secondary" disabled="@(!PuedeAvanzar)" @onclick="MesSiguiente">Mes siguiente →</button>
</div>

@if (dias is null)
{
    <p><em>Cargando...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered calendario-reservas align-top">
            <thead>
                <tr>
                    @foreach (var nombreDia in nombresDias)
                    {
                        <th class="text-center">@nombreDia</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var semana in Semanas())
                {
                    <tr>
                        @foreach (var dia in semana)
                        {
                            @if (dia is null)
                            {
                                <td class="bg-light"></td>
                            }
                            else
                            {
                                var celda = dia.Value;
                                var habilitado = EnRango(celda);
                                <td class="@(habilitado ? "dia-habilitado" : "text-muted bg-light")" style="cursor:@(habilitado ? "pointer" : "default")" @onclick="() => AbrirDia(celda)">
                                    <div class="fw-semibold">@celda.Day</div>
                                    @foreach (var tipo in tipos)
                                    {
                                        @if (ocupacion.TryGetValue((celda, tipo.Id), out var oc) && oc > 0)
                                        {
                                            <div class="small">@Abrev(tipo.Descripcion): @oc/@aforoMaximo</div>
                                        }
                                    }
                                </td>
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (diaSeleccionado is not null)
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-semibold">@diaSeleccionado.Value.ToString("dddd, d 'de' MMMM", CultureInfo.GetCultureInfo("es-ES"))</span>
            <button class="btn-close" @onclick="CerrarDia" aria-label="Cerrar"></button>
        </div>
        <div class="card-body">
            @if (reservasDelDia is null)
            {
                <p><em>Cargando...</em></p>
            }
            else if (reservasDelDia.Count == 0)
            {
                <p class="text-muted">No hay reservas este día.</p>
            }
            else
            {
                @foreach (var grupo in reservasDelDia.GroupBy(r => r.TipoReservaDescripcion))
                {
                    <h6 class="mt-2">@grupo.Key</h6>
                    <div class="d-flex flex-column gap-2 mb-3">
                        @foreach (var r in grupo)
                        {
                            <div class="d-flex align-items-center gap-2 border rounded p-2">
                                @if (!string.IsNullOrWhiteSpace(r.SocioFoto))
                                {
                                    <img src="@r.SocioFoto" alt="@r.SocioNombre" class="rounded-circle" style="width:40px;height:40px;object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-secondary-subtle d-flex align-items-center justify-content-center" style="width:40px;height:40px;">?</div>
                                }
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">@r.SocioNombre</div>
                                    <div class="small text-muted">@r.Comensales comensal(es) · @(r.Mesas.Count == 0 ? "sin mesa" : string.Join(", ", r.Mesas))</div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }

            @if (edicion is null)
            {
                <button class="btn btn-pena" disabled="@(!EnRango(diaSeleccionado.Value))" @onclick="Nuevo">Nueva reserva este día</button>
            }
            else
            {
                <EditForm Model="edicion" OnValidSubmit="Guardar" class="card">
                    <DataAnnotationsValidator />
                    <div class="card-header fw-semibold">Nueva reserva</div>
                    <div class="card-body">
                        @if (errorForm is not null)
                        {
                            <div class="alert alert-danger py-2">@errorForm</div>
                        }
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Tipo de reserva</label>
                                <InputSelect class="form-select" @bind-Value="edicion.TipoReservaId" @bind-Value:after="CargarMesasDisponibles">
                                    @foreach (var tipo in tipos)
                                    {
                                        <option value="@tipo.Id">@tipo.Descripcion</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">Socio</label>
                                @if (esJunta)
                                {
                                    <InputSelect class="form-select" @bind-Value="edicion.SocioId">
                                        <option value="">(sin socio)</option>
                                        @foreach (var socio in socios)
                                        {
                                            <option value="@socio.Id">@socio.Texto</option>
                                        }
                                    </InputSelect>
                                }
                                else
                                {
                                    <input class="form-control" disabled value="@NombrePropio" />
                                }
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Comensales</label>
                                <InputNumber class="form-control" @bind-Value="edicion.Comensales" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Mesas disponibles</label>
                                @if (mesasDisponibles is null)
                                {
                                    <p class="text-muted small"><em>Cargando...</em></p>
                                }
                                else if (mesasDisponibles.Count == 0)
                                {
                                    <p class="text-muted small">No quedan mesas libres para este turno.</p>
                                }
                                else
                                {
                                    <div class="d-flex flex-wrap gap-3">
                                        @foreach (var mesa in mesasDisponibles)
                                        {
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="@("mesa" + mesa.Id)"
                                                       checked="@mesasSeleccionadas.Contains(mesa.Id)"
                                                       @onchange="@(e => AlternarMesa(mesa.Id, (bool)e.Value!))" />
                                                <label class="form-check-label" for="@("mesa" + mesa.Id)">
                                                    @mesa.Descripcion (@mesa.Capacidad plazas)
                                                </label>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        <ValidationSummary class="mt-3 small" />
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <button type="submit" class="btn btn-pena">Guardar</button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="CancelarForm">Cancelar</button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    private static readonly string[] nombresDias = { "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom" };

    private long? socioId;
    private bool esJunta;
    private string NombrePropio => socios.FirstOrDefault(s => s.Id == socioId)?.Texto ?? "Yo";

    private DateOnly hoy;
    private DateOnly limiteMax;
    private DateOnly mesActual;
    private List<DateOnly>? dias;
    private Dictionary<(DateOnly, long), int> ocupacion = new();
    private int aforoMaximo;
    private List<Opcion> socios = new();
    private List<TipoReserva> tipos = new();
    private string? error;

    private static string Abrev(string descripcion) => descripcion.Length <= 4 ? descripcion : descripcion[..3] + ".";

    private DateOnly? diaSeleccionado;
    private List<ReservaFila>? reservasDelDia;

    private Reserva? edicion;
    private string? errorForm;
    private List<Mesa>? mesasDisponibles;
    private HashSet<long> mesasSeleccionadas = new();

    private bool PuedeRetroceder => new DateOnly(mesActual.Year, mesActual.Month, 1) > new DateOnly(hoy.Year, hoy.Month, 1);
    private bool PuedeAvanzar => new DateOnly(mesActual.Year, mesActual.Month, 1) < new DateOnly(limiteMax.Year, limiteMax.Month, 1);

    protected override async Task OnInitializedAsync()
    {
        hoy = DateOnly.FromDateTime(DateTime.Today);
        limiteMax = hoy.AddMonths(2);
        mesActual = hoy;

        if (EstadoAutenticacion is not null)
        {
            var estado = await EstadoAutenticacion;
            socioId = SocioAuth.SocioId(estado.User);
            esJunta = SocioAuth.EsJunta(estado.User);
        }

        await CargarMes();
    }

    private bool EnRango(DateOnly fecha) => fecha >= hoy && fecha <= limiteMax;

    private IEnumerable<DateOnly?[]> Semanas()
    {
        if (dias is null)
        {
            yield break;
        }

        var primerDia = new DateOnly(mesActual.Year, mesActual.Month, 1);
        var offset = ((int)primerDia.DayOfWeek + 6) % 7; // lunes = 0
        var celdas = new List<DateOnly?>();
        for (var i = 0; i < offset; i++)
        {
            celdas.Add(null);
        }
        celdas.AddRange(dias.Select(d => (DateOnly?)d));
        while (celdas.Count % 7 != 0)
        {
            celdas.Add(null);
        }

        for (var i = 0; i < celdas.Count; i += 7)
        {
            yield return celdas.Skip(i).Take(7).ToArray();
        }
    }

    private async Task MesAnterior()
    {
        if (!PuedeRetroceder)
        {
            return;
        }
        mesActual = mesActual.AddMonths(-1);
        CerrarDia();
        await CargarMes();
    }

    private async Task MesSiguiente()
    {
        if (!PuedeAvanzar)
        {
            return;
        }
        mesActual = mesActual.AddMonths(1);
        CerrarDia();
        await CargarMes();
    }

    private async Task CargarMes()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var primerDia = new DateOnly(mesActual.Year, mesActual.Month, 1);
            var ultimoDia = primerDia.AddMonths(1).AddDays(-1);
            dias = Enumerable.Range(0, ultimoDia.Day).Select(i => primerDia.AddDays(i)).ToList();

            aforoMaximo = await db.Mesas.Where(m => m.Activa != false).SumAsync(m => (int?)m.Capacidad) ?? 0;

            var filas = await db.Reservas
                .AsNoTracking()
                .Where(r => r.Estado == "activa" && r.Fecha >= primerDia && r.Fecha <= ultimoDia && r.TipoReservaId != null)
                .Select(r => new
                {
                    r.Fecha,
                    TipoReservaId = r.TipoReservaId!.Value,
                    Ocupacion = r.ReservaMesas.Sum(rm => (int?)rm.Mesa!.Capacidad) ?? 0
                })
                .ToListAsync();

            ocupacion = filas
                .GroupBy(f => (f.Fecha, f.TipoReservaId))
                .ToDictionary(g => g.Key, g => g.Sum(f => f.Ocupacion));

            tipos = await db.TiposReserva
                .AsNoTracking()
                .OrderBy(t => t.Descripcion)
                .ToListAsync();

            socios = (await db.Socios
                    .AsNoTracking()
                    .OrderBy(s => s.Nombre)
                    .Select(s => new { s.Id, s.Dni, s.Nombre, s.Apellidos })
                    .ToListAsync())
                .Select(s => new Opcion(s.Id, $"{s.Dni} · {s.Nombre} {s.Apellidos}".TrimEnd()))
                .ToList();

            error = null;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task AbrirDia(DateOnly fecha)
    {
        if (!EnRango(fecha))
        {
            return;
        }

        diaSeleccionado = fecha;
        edicion = null;
        errorForm = null;
        await CargarReservasDelDia();
    }

    private void CerrarDia()
    {
        diaSeleccionado = null;
        reservasDelDia = null;
        edicion = null;
    }

    private async Task CargarReservasDelDia()
    {
        if (diaSeleccionado is null)
        {
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            reservasDelDia = await db.Reservas
                .AsNoTracking()
                .Where(r => r.Estado == "activa" && r.Fecha == diaSeleccionado.Value)
                .OrderBy(r => r.TipoReserva!.Descripcion)
                .Select(r => new ReservaFila(
                    r.TipoReserva != null ? r.TipoReserva.Descripcion : "(sin tipo)",
                    r.Socio != null ? $"{r.Socio.Nombre} {r.Socio.Apellidos}".Trim() : "(sin socio)",
                    r.Socio != null ? r.Socio.UrlFoto : null,
                    r.Comensales ?? 0,
                    r.ReservaMesas.Select(rm => rm.Mesa!.Descripcion).ToList()))
                .ToListAsync();

            error = null;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private void Nuevo()
    {
        if (diaSeleccionado is null)
        {
            return;
        }

        edicion = new Reserva
        {
            Fecha = diaSeleccionado.Value,
            TipoReservaId = tipos.FirstOrDefault()?.Id,
            SocioId = esJunta ? null : socioId,
        };
        mesasSeleccionadas = new HashSet<long>();
        errorForm = null;
        _ = CargarMesasDisponibles();
    }

    private void CancelarForm()
    {
        edicion = null;
        errorForm = null;
    }

    private async Task CargarMesasDisponibles()
    {
        if (edicion is null)
        {
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var ocupadas = await db.ReservaMesas
                .Where(rm => rm.Reserva!.Estado == "activa"
                    && rm.Reserva.Fecha == edicion.Fecha
                    && rm.Reserva.TipoReservaId == edicion.TipoReservaId)
                .Select(rm => rm.MesaId!.Value)
                .ToListAsync();

            mesasDisponibles = await db.Mesas
                .AsNoTracking()
                .Where(m => m.Activa != false && !ocupadas.Contains(m.Id))
                .OrderBy(m => m.Descripcion)
                .ToListAsync();

            mesasSeleccionadas.RemoveWhere(id => mesasDisponibles.All(m => m.Id != id));
        }
        catch (Exception ex)
        {
            errorForm = ex.Message;
        }
    }

    private void AlternarMesa(long mesaId, bool marcada)
    {
        if (marcada)
        {
            mesasSeleccionadas.Add(mesaId);
        }
        else
        {
            mesasSeleccionadas.Remove(mesaId);
        }
    }

    private async Task Guardar()
    {
        if (edicion is null)
        {
            return;
        }

        if (!EnRango(edicion.Fecha))
        {
            errorForm = "La fecha debe estar entre hoy y dentro de dos meses.";
            return;
        }

        if (edicion.TipoReservaId is null)
        {
            errorForm = "Selecciona un tipo de reserva.";
            return;
        }

        if (!esJunta)
        {
            edicion.SocioId = socioId;
        }

        if (mesasSeleccionadas.Count == 0)
        {
            errorForm = "Selecciona al menos una mesa.";
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // Revalidar disponibilidad por si otro admin reservó mientras el formulario estaba abierto.
            var ocupadasAhora = await db.ReservaMesas
                .Where(rm => rm.Reserva!.Estado == "activa"
                    && rm.Reserva.Fecha == edicion.Fecha
                    && rm.Reserva.TipoReservaId == edicion.TipoReservaId
                    && mesasSeleccionadas.Contains(rm.MesaId!.Value))
                .AnyAsync();

            if (ocupadasAhora)
            {
                errorForm = "Alguna de las mesas seleccionadas ya no está disponible.";
                await CargarMesasDisponibles();
                return;
            }

            var mesasElegidas = await db.Mesas
                .Where(m => mesasSeleccionadas.Contains(m.Id))
                .ToListAsync();

            var capacidadTotal = mesasElegidas.Sum(m => m.Capacidad);
            if (capacidadTotal < (edicion.Comensales ?? 0))
            {
                errorForm = $"Las mesas seleccionadas suman {capacidadTotal} plazas, no llegan para {edicion.Comensales} comensales.";
                return;
            }

            edicion.ReservaMesas = mesasElegidas.Select(m => new ReservaMesa { MesaId = m.Id }).ToList();
            db.Reservas.Add(edicion);
            await db.SaveChangesAsync();

            edicion = null;
            mesasSeleccionadas.Clear();
            errorForm = null;
            await CargarMes();
            await CargarReservasDelDia();
        }
        catch (Exception ex)
        {
            errorForm = ex.Message;
        }
    }

    private record Opcion(long Id, string Texto);

    private record ReservaFila(string TipoReservaDescripcion, string SocioNombre, string? SocioFoto, int Comensales, List<string> Mesas);
}
