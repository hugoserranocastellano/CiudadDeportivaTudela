@page "/contabilidad"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject SupabaseStorageService Storage

<PageTitle>Contabilidad</PageTitle>

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <a class="btn btn-outline-secondary btn-sm" href="inicio">← Volver</a>
    <h1 class="mb-0 text-center flex-grow-1">Contabilidad</h1>
</div>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert"><code>@error</code></div>
}

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-2">
                <label class="form-label">Desde</label>
                <input type="date" class="form-control" value="@filtroDesde?.ToString("yyyy-MM-dd")"
                       @onchange="e => filtroDesde = ParseFecha(e.Value)" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Hasta</label>
                <input type="date" class="form-control" value="@filtroHasta?.ToString("yyyy-MM-dd")"
                       @onchange="e => filtroHasta = ParseFecha(e.Value)" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Socio</label>
                <InputSelect class="form-select" @bind-Value="filtroSocioId">
                    <option value="">(todos)</option>
                    @foreach (var socio in socios)
                    {
                        <option value="@socio.Id">@socio.Texto</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-2">
                <label class="form-label">Estado</label>
                <InputSelect class="form-select" @bind-Value="filtroEstado">
                    <option value="">(todos)</option>
                    <option value="pagado">Pagado</option>
                    <option value="abierto">Abierto</option>
                </InputSelect>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="button" class="btn btn-pena" @onclick="Cargar">Filtrar</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="Limpiar">Limpiar</button>
            </div>
        </div>
    </div>
</div>

@if (edicion is not null)
{
    <div class="card mb-3">
        <div class="card-header fw-semibold">Editar ticket #@edicion.Id</div>
        <div class="card-body">
            @if (errorEdicion is not null)
            {
                <div class="alert alert-danger py-2">@errorEdicion</div>
            }
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Fecha</label>
                    <input type="datetime-local" class="form-control" value="@edicion.Fecha?.ToString("yyyy-MM-ddTHH:mm")"
                           @onchange="e => edicion.Fecha = DateTime.TryParse(e.Value?.ToString(), out var f) ? f : edicion.Fecha" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Socio</label>
                    <InputSelect class="form-select" @bind-Value="edicionSocioId">
                        <option value="">(sin socio)</option>
                        @foreach (var s in socios)
                        {
                            <option value="@s.Id">@s.Texto</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Importe</label>
                    <input type="number" step="0.01" class="form-control" @bind="edicion.ImporteTotal" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Estado</label>
                    <InputSelect class="form-select" @bind-Value="edicion.Estado">
                        <option value="abierto">Abierto</option>
                        <option value="pagado">Pagado</option>
                    </InputSelect>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Forma de pago</label>
                    <InputSelect class="form-select" @bind-Value="edicionFormaPago">
                        <option value="">(ninguna)</option>
                        <option value="tarjeta">Tarjeta</option>
                        <option value="efectivo">Efectivo</option>
                    </InputSelect>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Foto del ticket</label>
                    <FotoCropper Bucket="Tickets" Path="@edicion.Id.ToString()" FotoActualUrl="@edicionFotoUrl"
                                 FotoSubida="url => edicionFotoUrl = url" FotoBorrada="() => edicionFotoUrl = null" />
                </div>
            </div>
        </div>
        <div class="card-footer d-flex gap-2">
            <button type="button" class="btn btn-pena" disabled="@guardandoEdicion" @onclick="GuardarEdicion">
                @(guardandoEdicion ? "Guardando..." : "Guardar")
            </button>
            <button type="button" class="btn btn-outline-secondary" @onclick="() => edicion = null">Cancelar</button>
        </div>
    </div>
}

@if (tickets is null)
{
    <p><em>Cargando...</em></p>
}
else if (tickets.Count == 0)
{
    <p><em>No hay tickets que coincidan con el filtro.</em></p>
}
else
{
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Ingresado (pagado)</div>
                    <div class="fs-4 fw-bold text-success">@TotalPagado.ToString("N2") €</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Pendiente (abierto)</div>
                    <div class="fs-4 fw-bold text-warning">@TotalAbierto.ToString("N2") €</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Total tickets</div>
                    <div class="fs-4 fw-bold">@tickets.Count</div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive tabla-marco">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th role="button" @onclick='() => Ordenar("id")'>#@(Flecha("id"))</th>
                    <th role="button" @onclick='() => Ordenar("fecha")'>Fecha@(Flecha("fecha"))</th>
                    <th role="button" @onclick='() => Ordenar("socio")'>Socio@(Flecha("socio"))</th>
                    <th class="text-end" role="button" @onclick='() => Ordenar("importe")'>Importe@(Flecha("importe"))</th>
                    <th role="button" @onclick='() => Ordenar("estado")'>Estado@(Flecha("estado"))</th>
                    <th role="button" @onclick='() => Ordenar("formaPago")'>Forma de pago@(Flecha("formaPago"))</th>
                    <th role="button" @onclick='() => Ordenar("revisado")'>Revisado@(Flecha("revisado"))</th>
                    <th>Foto</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Ordenados)
                {
                    <tr class="@(t.Estado == "abierto" ? "table-warning" : null)">
                        <td>@t.Id</td>
                        <td>@t.Fecha?.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@t.SocioNombre</td>
                        <td class="text-end">@((t.ImporteTotal ?? 0).ToString("N2")) €</td>
                        <td>@t.Estado</td>
                        <td>@(t.FormaPago ?? "—")</td>
                        <td>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="@("revisado" + t.Id)"
                                       checked="@(t.Revisado == true)"
                                       @onchange="@(e => AlternarRevisado(t, (bool)e.Value!))" />
                            </div>
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(t.UrlFotoTicket))
                            {
                                <a href="@t.UrlFotoTicket" target="_blank">
                                    <img src="@t.UrlFotoTicket" alt="Foto ticket" style="width:40px;height:40px;object-fit:cover;" class="rounded" />
                                </a>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Editar(t)">Editar</button>
                            @if (idBorrando == t.Id)
                            {
                                <button class="btn btn-sm btn-danger" @onclick="() => Borrar(t.Id)">Confirmar</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => idBorrando = null">No</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => idBorrando = t.Id">Borrar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Fila>? tickets;
    private List<Opcion> socios = new();
    private DateOnly? filtroDesde;
    private DateOnly? filtroHasta;
    private string filtroSocioId = string.Empty;
    private string filtroEstado = string.Empty;
    private string? error;
    private long? idBorrando;

    private Ticket? edicion;
    private string edicionSocioId = string.Empty;
    private string edicionFormaPago = string.Empty;
    private string? edicionFotoUrl;
    private bool guardandoEdicion;
    private string? errorEdicion;

    private string ordenCampo = "fecha";
    private bool ordenDescendente = true;

    private decimal TotalPagado => tickets?.Where(t => t.Estado == "pagado").Sum(t => t.ImporteTotal ?? 0) ?? 0;
    private decimal TotalAbierto => tickets?.Where(t => t.Estado == "abierto").Sum(t => t.ImporteTotal ?? 0) ?? 0;

    private static DateOnly? ParseFecha(object? valor) =>
        DateOnly.TryParse(valor?.ToString(), out var f) ? f : null;

    private List<Fila> Ordenados
    {
        get
        {
            if (tickets is null)
            {
                return new List<Fila>();
            }

            Func<Fila, object?> clave = ordenCampo switch
            {
                "id" => t => t.Id,
                "socio" => t => t.SocioNombre,
                "importe" => t => t.ImporteTotal,
                "estado" => t => t.Estado,
                "formaPago" => t => t.FormaPago,
                "revisado" => t => t.Revisado,
                _ => t => t.Fecha,
            };

            IEnumerable<Fila> resultado = ordenDescendente
                ? tickets.OrderByDescending(clave)
                : tickets.OrderBy(clave);

            return resultado.ToList();
        }
    }

    private void Ordenar(string campo)
    {
        if (ordenCampo == campo)
        {
            ordenDescendente = !ordenDescendente;
        }
        else
        {
            ordenCampo = campo;
            ordenDescendente = false;
        }
    }

    private string Flecha(string campo) =>
        ordenCampo != campo ? string.Empty : ordenDescendente ? " ▼" : " ▲";

    [CascadingParameter]
    private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    // Acceso: junta, o el socio Id=4 (tesorero), hasta que se modele un rol propio.
    private const long IdTesorero = 4;

    protected override async Task OnInitializedAsync()
    {
        if (EstadoAutenticacion is not null)
        {
            var estado = await EstadoAutenticacion;
            var esJunta = SocioAuth.EsJunta(estado.User);
            var esTesorero = SocioAuth.SocioId(estado.User) == IdTesorero;
            if (!esJunta && !esTesorero)
            {
                Navigation.NavigateTo("/inicio", forceLoad: true);
                return;
            }
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            socios = (await db.Socios
                    .AsNoTracking()
                    .OrderBy(s => s.Nombre)
                    .Select(s => new { s.Id, s.Dni, s.Nombre, s.Apellidos })
                    .ToListAsync())
                .Select(s => new Opcion(s.Id, $"{s.Dni} · {s.Nombre} {s.Apellidos}".TrimEnd()))
                .ToList();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }

        await Cargar();
    }

    private void Limpiar()
    {
        filtroDesde = null;
        filtroHasta = null;
        filtroSocioId = string.Empty;
        filtroEstado = string.Empty;
        _ = Cargar();
    }

    private async Task Cargar()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            IQueryable<Ticket> consulta = db.Tickets.AsNoTracking();

            if (filtroDesde is DateOnly desde)
            {
                var desdeUtc = desde.ToDateTime(TimeOnly.MinValue);
                consulta = consulta.Where(t => t.Fecha >= desdeUtc);
            }

            if (filtroHasta is DateOnly hasta)
            {
                var hastaUtc = hasta.ToDateTime(TimeOnly.MaxValue);
                consulta = consulta.Where(t => t.Fecha <= hastaUtc);
            }

            if (long.TryParse(filtroSocioId, out var socioId))
            {
                consulta = consulta.Where(t => t.SocioId == socioId);
            }

            if (!string.IsNullOrWhiteSpace(filtroEstado))
            {
                consulta = consulta.Where(t => t.Estado == filtroEstado);
            }

            tickets = await consulta
                .Select(t => new Fila(
                    t.Id,
                    t.Fecha,
                    t.SocioId,
                    t.Socio != null ? $"{t.Socio.Nombre} {t.Socio.Apellidos}".Trim() : "(sin socio)",
                    t.ImporteTotal,
                    t.Estado,
                    t.FormaPago,
                    t.Revisado,
                    t.UrlFotoTicket))
                .ToListAsync();

            error = null;
        }
        catch (Exception ex)
        {
            tickets ??= new List<Fila>();
            error = ex.Message;
        }
    }

    private async Task AlternarRevisado(Fila ticket, bool revisado)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await db.Tickets.Where(t => t.Id == ticket.Id)
                .ExecuteUpdateAsync(t => t.SetProperty(x => x.Revisado, revisado));

            var indice = tickets!.FindIndex(t => t.Id == ticket.Id);
            if (indice >= 0)
            {
                tickets[indice] = ticket with { Revisado = revisado };
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private void Editar(Fila fila)
    {
        edicion = new Ticket
        {
            Id = fila.Id,
            Fecha = fila.Fecha,
            SocioId = fila.SocioId,
            ImporteTotal = fila.ImporteTotal,
            Estado = fila.Estado,
            FormaPago = fila.FormaPago,
            Revisado = fila.Revisado,
        };
        edicionSocioId = fila.SocioId?.ToString() ?? string.Empty;
        edicionFormaPago = fila.FormaPago ?? string.Empty;
        edicionFotoUrl = fila.UrlFotoTicket;
        errorEdicion = null;
        idBorrando = null;
    }

    private async Task GuardarEdicion()
    {
        if (edicion is null)
        {
            return;
        }

        guardandoEdicion = true;
        errorEdicion = null;
        try
        {
            long? socioId = long.TryParse(edicionSocioId, out var sId) ? sId : null;
            string? formaPago = string.IsNullOrWhiteSpace(edicionFormaPago) ? null : edicionFormaPago;

            await using var db = await DbFactory.CreateDbContextAsync();
            await db.Tickets.Where(t => t.Id == edicion.Id).ExecuteUpdateAsync(t => t
                .SetProperty(x => x.Fecha, edicion.Fecha)
                .SetProperty(x => x.SocioId, socioId)
                .SetProperty(x => x.ImporteTotal, edicion.ImporteTotal)
                .SetProperty(x => x.Estado, edicion.Estado)
                .SetProperty(x => x.FormaPago, formaPago)
                .SetProperty(x => x.UrlFotoTicket, edicionFotoUrl));

            edicion = null;
            await Cargar();
        }
        catch (Exception ex)
        {
            errorEdicion = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            guardandoEdicion = false;
        }
    }

    private async Task Borrar(long id)
    {
        idBorrando = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // ticket_lineas cae en cascada; movimientos_stock no, así que primero
            // se suelta la referencia para que el borrado no choque con la FK.
            await db.MovimientosStock
                .Where(m => m.TicketId == id)
                .ExecuteUpdateAsync(s => s.SetProperty(m => m.TicketId, (long?)null));

            await db.Tickets.Where(t => t.Id == id).ExecuteDeleteAsync();
            await Cargar();
        }
        catch (Exception ex)
        {
            error = $"No se pudo borrar el ticket: {ex.Message}";
        }
    }

    private record Fila(
        long Id, DateTime? Fecha, long? SocioId, string SocioNombre, decimal? ImporteTotal,
        string Estado, string? FormaPago, bool? Revisado, string? UrlFotoTicket);

    private record Opcion(long Id, string Texto);
}
