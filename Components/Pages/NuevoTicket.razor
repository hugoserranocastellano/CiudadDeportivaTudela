@page "/tickets/nuevo"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IAsyncDisposable
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navegacion
@inject IJSRuntime JS

<PageTitle>Nuevo ticket · Peña Ciudad Deportiva</PageTitle>

@* Mientras haya líneas sin pagar, se avisa antes de navegar a otra página de
   la app (NavigationLock) o de cerrar/recargar la pestaña (JS beforeunload
   en wwwroot/js/avisoSalida.js) — aunque el ticket ya está autoguardado
   desde la primera línea y se puede retomar luego, es un aviso extra para
   que no parezca que se pierde algo. *@
<NavigationLock OnBeforeInternalNavigation="ConfirmarSalida" />

@if (socio is null)
{
    <p><em>Cargando...</em></p>
}
else
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="mb-0">Nuevo ticket</h1>
            <div class="text-muted">@socio.Nombre @socio.Apellidos · @fecha.ToString("dd/MM/yyyy HH:mm")</div>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-pena" disabled="@(lineas.Count == 0)" @onclick="AbrirPago">Pagar</button>
            <button type="button" class="btn btn-outline-danger" @onclick="Cancelar">Cancelar</button>
        </div>
    </div>

    @if (error is not null)
    {
        <div class="alert alert-danger py-2"><code>@error</code></div>
    }

    @if (mensajeCatalogo is not null)
    {
        <div class="alert alert-success py-2 text-center shadow"
             style="position:fixed; bottom:1rem; left:50%; transform:translateX(-50%); z-index:1050; max-width:90vw;">
            @mensajeCatalogo
        </div>
    }

    @if (mostrarPago)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Pagar ticket</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => mostrarPago = false">← Volver</button>
            </div>
            <div class="card-body">
                @if (errorPago is not null)
                {
                    <div class="alert alert-danger py-2">@errorPago</div>
                }
                <p>Total a pagar: <strong>@Total.ToString("0.00")€</strong></p>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-body">
                                <h6>He pagado con tarjeta (TPV)</h6>
                                <p class="text-muted small">Sube una foto del recibo del TPV.</p>
                                @if (ticketId is long id)
                                {
                                    <SubidaSimple Bucket="Tickets" Path="@id.ToString()" FotoSubida="PagarConTarjeta" Disabled="@pagando" />
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-body">
                                <h6>Pagar en metálico</h6>
                                <p class="text-muted small">
                                    Apunta este número en el sobre: <strong class="fs-5">#@ticketId</strong>
                                </p>
                                <button type="button" class="btn btn-pena" disabled="@pagando" @onclick="PagarEnEfectivo">
                                    @(pagando ? "Confirmando..." : "Confirmar pago en efectivo")
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex align-items-center gap-2 mb-2">
                <label class="form-label mb-0">Añadir producto</label>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => verArticulos = true">Ver artículos</button>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <input class="form-control" style="max-width: 320px;" list="listaArticulos"
                       placeholder="Escribe o elige un producto (ej. cer)"
                       @bind="filtro" @bind:event="oninput" @bind:after="IntentarAnadirPorTexto" />
                <datalist id="listaArticulos">
                    @foreach (var a in articulos)
                    {
                        <option value="@Etiqueta(a)"></option>
                    }
                </datalist>
                @if (ArticuloCoincidente is { } coincidente && !string.IsNullOrWhiteSpace(coincidente.UrlFoto))
                {
                    <img src="@coincidente.UrlFoto" alt="@coincidente.Descripcion" style="width:40px;height:40px;object-fit:cover;" class="rounded" />
                }
            </div>
        </div>
    </div>

    @if (verArticulos)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Artículos <small class="text-muted fw-normal">(doble clic / doble toque para añadir)</small></span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => verArticulos = false">← Volver</button>
            </div>
            <div class="card-body">
                <div class="row row-cols-2 row-cols-md-4 g-3">
                    @foreach (var a in articulos)
                    {
                        <div class="col text-center" role="button" style="cursor:pointer" @ondblclick="() => AnadirDesdeCatalogo(a)">
                            @if (!string.IsNullOrWhiteSpace(a.UrlFoto))
                            {
                                <img src="@a.UrlFoto" alt="@a.Descripcion" style="width:100%;max-width:100px;height:100px;object-fit:cover;" class="rounded" />
                            }
                            else
                            {
                                <div class="bg-light rounded mx-auto" style="width:100px;height:100px;"></div>
                            }
                            <div class="small mt-1">@a.Descripcion</div>
                            <div class="small text-muted">@a.PrecioUnidad.ToString("0.00")€</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (lineas.Count == 0)
    {
        <p class="text-muted">Aún no has añadido ningún producto.</p>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th></th>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Precio</th>
                        <th>Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var linea in lineas)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(linea.Articulo!.UrlFoto))
                                {
                                    <img src="@linea.Articulo.UrlFoto" alt="@linea.Articulo.Descripcion" style="width:32px;height:32px;object-fit:cover;" class="rounded" />
                                }
                            </td>
                            <td>@linea.Articulo!.Descripcion</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => CambiarCantidad(linea, -1)">-</button>
                                    <span>@linea.Unidades</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => CambiarCantidad(linea, 1)">+</button>
                                </div>
                            </td>
                            <td>@linea.PrecioUnidad?.ToString("0.00")€</td>
                            <td>@linea.Subtotal?.ToString("0.00")€</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => EliminarLinea(linea)" title="Eliminar línea">🗑</button>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="4" class="text-end">Total</th>
                        <th>@Total.ToString("0.00")€</th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    }

}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    private long? socioId;
    private Socio? socio;
    private DateTime fecha = DateTime.Now;
    private long? ticketId;

    private List<Articulo> articulos = new();
    private string filtro = string.Empty;
    private bool verArticulos;

    // Coincidencia en vivo mientras se escribe, para enseñar la foto del producto
    // antes incluso de que el socio termine de elegirlo en el datalist.
    private Articulo? ArticuloCoincidente => string.IsNullOrWhiteSpace(filtro)
        ? null
        : articulos.FirstOrDefault(a => a.Descripcion.Contains(filtro.Trim(), StringComparison.OrdinalIgnoreCase));

    private List<TicketLinea> lineas = new();

    private string? error;
    private bool mostrarPago;
    private bool pagando;
    private string? errorPago;

    private IJSObjectReference? moduloAviso;

    private decimal Total => lineas.Sum(l => l.Subtotal ?? 0);

    private static string Etiqueta(Articulo a) => $"{a.Descripcion} ({a.PrecioUnidad.ToString("0.00")}€)";

    protected override async Task OnInitializedAsync()
    {
        if (EstadoAutenticacion is null)
        {
            return;
        }

        var estado = await EstadoAutenticacion;
        socioId = SocioAuth.SocioId(estado.User);

        if (socioId is null)
        {
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            socio = await db.Socios.AsNoTracking().FirstOrDefaultAsync(s => s.Id == socioId);

            articulos = await db.Articulos
                .AsNoTracking()
                .Where(a => a.Activo != false)
                .OrderBy(a => a.Descripcion)
                .ToListAsync();

            // Si el socio ya tenía un ticket a medias (salió sin pagar), se
            // retoma en vez de empezar en blanco.
            var abierto = await db.Tickets
                .AsNoTracking()
                .Include(t => t.Lineas).ThenInclude(l => l.Articulo)
                .Where(t => t.SocioId == socioId && t.Estado == "abierto")
                .OrderByDescending(t => t.Id)
                .FirstOrDefaultAsync();

            if (abierto is not null)
            {
                ticketId = abierto.Id;
                fecha = abierto.Fecha ?? DateTime.Now;
                lineas = abierto.Lineas.ToList();
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Llamar a JS interop desde OnInitializedAsync puede fallar durante el
        // prerenderizado; se espera a que el circuito esté vivo de verdad.
        if (firstRender && lineas.Count > 0)
        {
            await ActualizarAvisoSalida();
        }
    }

    private async Task<IJSObjectReference> ModuloAvisoAsync()
    {
        moduloAviso ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/avisoSalida.js");
        return moduloAviso;
    }

    private async Task ActualizarAvisoSalida()
    {
        var js = await ModuloAvisoAsync();
        await js.InvokeVoidAsync(lineas.Count > 0 ? "activar" : "desactivar");
    }

    private async Task ConfirmarSalida(LocationChangingContext context)
    {
        if (lineas.Count == 0)
        {
            return;
        }

        var continuar = await JS.InvokeAsync<bool>(
            "confirm",
            "Tienes un ticket sin pagar. Queda guardado y puedes continuarlo luego desde \"Mis tickets\", pero ¿seguro que quieres salir ahora?");
        if (!continuar)
        {
            context.PreventNavigation();
        }
    }

    private void IntentarAnadirPorTexto()
    {
        if (string.IsNullOrWhiteSpace(filtro))
        {
            return;
        }

        var texto = filtro.Trim();

        // El navegador rellena el input con el texto exacto de la opción del datalist
        // al elegirla, así que una coincidencia exacta significa que el socio ha seleccionado
        // el producto (y no que simplemente está escribiendo para filtrar).
        var articulo = articulos.FirstOrDefault(a => Etiqueta(a).Equals(texto, StringComparison.OrdinalIgnoreCase));
        if (articulo is null)
        {
            return;
        }

        _ = AnadirYGuardar(articulo);
        filtro = string.Empty;
        error = null;
    }

    private string? mensajeCatalogo;

    private int tokenMensajeCatalogo;

    private async Task AnadirDesdeCatalogo(Articulo articulo)
    {
        await AnadirYGuardar(articulo);
        mensajeCatalogo = $"«{articulo.Descripcion}» añadido.";

        var token = ++tokenMensajeCatalogo;
        await Task.Delay(2000);
        // Si mientras tanto se añadió otro artículo, ese nuevo mensaje ya se
        // encarga de su propio borrado; no lo pisamos aquí.
        if (token == tokenMensajeCatalogo)
        {
            mensajeCatalogo = null;
            StateHasChanged();
        }
    }

    private async Task AnadirYGuardar(Articulo articulo)
    {
        Anadir(articulo);
        await PersistirAsync();
    }

    private void Anadir(Articulo articulo)
    {
        var existente = lineas.FirstOrDefault(l => l.ArticuloId == articulo.Id);
        if (existente is not null)
        {
            existente.Unidades = (existente.Unidades ?? 1) + 1;
            existente.Subtotal = (existente.PrecioUnidad ?? 0) * existente.Unidades;
        }
        else
        {
            lineas.Add(new TicketLinea
            {
                ArticuloId = articulo.Id,
                Articulo = articulo,
                PrecioUnidad = articulo.PrecioUnidad,
                Unidades = 1,
                Subtotal = articulo.PrecioUnidad,
            });
        }
    }

    private async Task CambiarCantidad(TicketLinea linea, int delta)
    {
        var nuevasUnidades = (linea.Unidades ?? 1) + delta;
        if (nuevasUnidades < 1)
        {
            return;
        }

        linea.Unidades = nuevasUnidades;
        linea.Subtotal = (linea.PrecioUnidad ?? 0) * nuevasUnidades;
        await PersistirAsync();
    }

    private async Task EliminarLinea(TicketLinea linea)
    {
        lineas.Remove(linea);
        await PersistirAsync();
    }

    /// <summary>
    /// Crea el ticket en cuanto tiene la primera línea, y en cada cambio
    /// posterior reemplaza sus líneas por las actuales (borrar+reinsertar es
    /// más simple y fiable que rastrear altas/bajas individuales una a una).
    /// Así el ticket queda recuperable si el socio sale sin pagar.
    /// </summary>
    private async Task PersistirAsync()
    {
        if (socioId is null)
        {
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            if (ticketId is null)
            {
                if (lineas.Count == 0)
                {
                    return;
                }

                var nuevo = new Ticket
                {
                    Fecha = fecha.ToUniversalTime(),
                    SocioId = socioId,
                    Estado = "abierto",
                    ImporteTotal = Total,
                };
                db.Tickets.Add(nuevo);
                await db.SaveChangesAsync();
                ticketId = nuevo.Id;
            }

            await db.TicketLineas.Where(l => l.TicketId == ticketId).ExecuteDeleteAsync();
            foreach (var linea in lineas)
            {
                db.TicketLineas.Add(new TicketLinea
                {
                    TicketId = ticketId,
                    ArticuloId = linea.ArticuloId,
                    PrecioUnidad = linea.PrecioUnidad,
                    Unidades = linea.Unidades,
                    Subtotal = linea.Subtotal,
                });
            }
            await db.SaveChangesAsync();

            await db.Tickets.Where(t => t.Id == ticketId)
                .ExecuteUpdateAsync(t => t.SetProperty(x => x.ImporteTotal, Total));

            error = null;
            await ActualizarAvisoSalida();
        }
        catch (Exception ex)
        {
            error = ex.InnerException?.Message ?? ex.Message;
        }
    }

    private void AbrirPago()
    {
        mostrarPago = true;
        errorPago = null;
    }

    private async Task PagarConTarjeta(string urlRecibo)
    {
        await FinalizarPago("tarjeta", urlRecibo);
    }

    private async Task PagarEnEfectivo()
    {
        await FinalizarPago("efectivo", null);
    }

    private async Task FinalizarPago(string formaPago, string? urlRecibo)
    {
        if (ticketId is null)
        {
            return;
        }

        pagando = true;
        errorPago = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            if (urlRecibo is not null)
            {
                await db.Tickets.Where(t => t.Id == ticketId).ExecuteUpdateAsync(t => t
                    .SetProperty(x => x.Estado, "pagado")
                    .SetProperty(x => x.FormaPago, formaPago)
                    .SetProperty(x => x.UrlFotoTicket, urlRecibo));
            }
            else
            {
                await db.Tickets.Where(t => t.Id == ticketId).ExecuteUpdateAsync(t => t
                    .SetProperty(x => x.Estado, "pagado")
                    .SetProperty(x => x.FormaPago, formaPago));
            }

            await (await ModuloAvisoAsync()).InvokeVoidAsync("desactivar");
            Navegacion.NavigateTo("/mis-tickets");
        }
        catch (Exception ex)
        {
            errorPago = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            pagando = false;
        }
    }

    private async Task Cancelar()
    {
        if (ticketId is long id)
        {
            try
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                // Las líneas caen en cascada al borrar el ticket.
                await db.Tickets.Where(t => t.Id == id).ExecuteDeleteAsync();
            }
            catch (Exception ex)
            {
                error = ex.Message;
                return;
            }
        }

        if (moduloAviso is not null)
        {
            await moduloAviso.InvokeVoidAsync("desactivar");
        }

        Navegacion.NavigateTo("/inicio");
    }

    public async ValueTask DisposeAsync()
    {
        if (moduloAviso is not null)
        {
            try
            {
                await moduloAviso.InvokeVoidAsync("desactivar");
                await moduloAviso.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // El circuito ya se cerró; nada que limpiar.
            }
        }
    }
}
