@page "/categorias-gasto"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Categorías de gasto</PageTitle>
<JuntaGuard />

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <a class="btn btn-outline-secondary btn-sm" href="inicio">← Volver</a>
    <h1 class="mb-0 text-center flex-grow-1">Categorías de gasto</h1>
    <button class="btn btn-pena" @onclick="Nuevo">Nueva categoría</button>
</div>

@if (mensajeExito is not null)
{
    <div class="alert alert-success py-2">@mensajeExito</div>
}

@if (error is not null)
{
    <div class="alert alert-danger" role="alert"><code>@error</code></div>
}

@if (edicion is not null)
{
    <EditForm Model="edicion" OnValidSubmit="Guardar" class="card mb-4">
        <DataAnnotationsValidator />
        <div class="card-header fw-semibold">@(esNuevo ? "Nueva categoría" : $"Editar «{edicion.Descripcion}»")</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Descripción</label>
                    <InputText class="form-control" @bind-Value="edicion.Descripcion" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Tipo de categoría</label>
                    <InputText class="form-control" list="tiposCategoria" @bind-Value="edicion.TipoCategoria" />
                    <datalist id="tiposCategoria">
                        <option value="fijo" />
                        <option value="variable" />
                        <option value="extraordinario" />
                    </datalist>
                </div>
            </div>
            <ValidationSummary class="mt-3 small" />
        </div>
        <div class="card-footer d-flex gap-2">
            <button type="submit" class="btn btn-pena">Guardar</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancelar">Cancelar</button>
        </div>
    </EditForm>
}

@if (categorias is null)
{
    <p><em>Cargando...</em></p>
}
else if (categorias.Count == 0)
{
    <p><em>No hay categorías todavía.</em></p>
}
else
{
    <p class="text-muted">@categorias.Count categoría(s).</p>

    <div class="table-responsive tabla-marco">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th role="button" @onclick='() => Ordenar("descripcion")'>Descripción@(Flecha("descripcion"))</th>
                    <th role="button" @onclick='() => Ordenar("tipo")'>Tipo@(Flecha("tipo"))</th>
                    <th class="text-end" role="button" @onclick='() => Ordenar("gastos")'>Gastos@(Flecha("gastos"))</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fila in Ordenados)
                {
                    <tr>
                        <td>@fila.Categoria.Descripcion</td>
                        <td>@fila.Categoria.TipoCategoria</td>
                        <td class="text-end">@fila.NumeroGastos</td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Editar(fila.Categoria)">Editar</button>
                            @if (idBorrando == fila.Categoria.Id)
                            {
                                <button class="btn btn-sm btn-danger" @onclick="() => Borrar(fila.Categoria.Id)">Confirmar</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => idBorrando = null">No</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => idBorrando = fila.Categoria.Id">Borrar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Fila>? categorias;
    private CategoriaGasto? edicion;
    private bool esNuevo;
    private long? idBorrando;
    private string? error;
    private string? mensajeExito;

    private string ordenCampo = "tipo";
    private bool ordenDescendente;

    private List<Fila> Ordenados
    {
        get
        {
            if (categorias is null)
            {
                return new List<Fila>();
            }

            Func<Fila, object?> clave = ordenCampo switch
            {
                "descripcion" => f => f.Categoria.Descripcion,
                "gastos" => f => f.NumeroGastos,
                _ => f => f.Categoria.TipoCategoria,
            };

            IEnumerable<Fila> resultado = ordenDescendente
                ? categorias.OrderByDescending(clave)
                : categorias.OrderBy(clave);

            return resultado.ToList();
        }
    }

    private void Ordenar(string campo)
    {
        if (ordenCampo == campo)
        {
            ordenDescendente = !ordenDescendente;
        }
        else
        {
            ordenCampo = campo;
            ordenDescendente = false;
        }
    }

    private string Flecha(string campo) =>
        ordenCampo != campo ? string.Empty : ordenDescendente ? " ▼" : " ▲";

    protected override Task OnInitializedAsync() => Cargar();

    private async Task Cargar()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            categorias = await db.CategoriasGasto
                .AsNoTracking()
                .OrderBy(c => c.TipoCategoria)
                .ThenBy(c => c.Descripcion)
                .Select(c => new Fila(c, c.Gastos.Count))
                .ToListAsync();

            error = null;
        }
        catch (Exception ex)
        {
            categorias ??= new List<Fila>();
            error = ex.Message;
        }
    }

    private void Nuevo()
    {
        edicion = new CategoriaGasto();
        esNuevo = true;
        idBorrando = null;
        mensajeExito = null;
    }

    private void Editar(CategoriaGasto categoria)
    {
        edicion = new CategoriaGasto
        {
            Id = categoria.Id,
            Descripcion = categoria.Descripcion,
            TipoCategoria = categoria.TipoCategoria,
        };
        esNuevo = false;
        idBorrando = null;
    }

    private void Cancelar() => edicion = null;

    private async Task Guardar()
    {
        if (edicion is null)
        {
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            if (esNuevo)
            {
                db.CategoriasGasto.Add(edicion);
            }
            else
            {
                db.CategoriasGasto.Update(edicion);
            }

            await db.SaveChangesAsync();
            mensajeExito = esNuevo ? "Categoría creada." : "Categoría actualizada.";
            edicion = null;
            await Cargar();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task Borrar(long id)
    {
        idBorrando = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            await db.CategoriasGasto.Where(c => c.Id == id).ExecuteDeleteAsync();
            await Cargar();
        }
        catch (Exception ex)
        {
            error = $"No se pudo borrar la categoría (puede tener gastos asociados): {ex.Message}";
        }
    }

    private record Fila(CategoriaGasto Categoria, int NumeroGastos);
}
