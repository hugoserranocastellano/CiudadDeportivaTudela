@page "/mis-reservas"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Mis reservas</PageTitle>

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <a class="btn btn-outline-secondary btn-sm" href="inicio">← Volver</a>
    <h1 class="mb-0 text-center flex-grow-1">Mis reservas</h1>
    <a class="btn btn-sm btn-pena" href="reservas">Ver calendario</a>
</div>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert"><code>@error</code></div>
}
@if (mensaje is not null)
{
    <div class="alert alert-success py-2">@mensaje</div>
}

@if (reservas is null)
{
    <p><em>Cargando...</em></p>
}
else if (reservas.Count == 0)
{
    <p><em>No tienes reservas registradas.</em></p>
}
else
{
    @foreach (var grupo in Grupos)
    {
        <h2 class="h5 mt-3">@NombreMes(grupo.Key)</h2>
        <div class="table-responsive tabla-marco mb-4">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th role="button" @onclick='() => Ordenar("id")'>#@(Flecha("id"))</th>
                        <th role="button" @onclick='() => Ordenar("fecha")'>Fecha@(Flecha("fecha"))</th>
                        <th class="text-end" role="button" @onclick='() => Ordenar("comensales")'>Comensales@(Flecha("comensales"))</th>
                        <th role="button" @onclick='() => Ordenar("tipo")'>Tipo@(Flecha("tipo"))</th>
                        <th role="button" @onclick='() => Ordenar("estado")'>Estado@(Flecha("estado"))</th>
                        <th role="button" @onclick='() => Ordenar("limpieza")'>Limpieza@(Flecha("limpieza"))</th>
                        <th>Mesas</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reserva in OrdenarGrupo(grupo))
                    {
                        <tr>
                            <td>@reserva.Id</td>
                            <td>@reserva.Fecha.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">@reserva.Comensales</td>
                            <td>@reserva.TipoReserva</td>
                            <td>@reserva.Estado</td>
                            <td>@(reserva.Limpieza == true ? "Sí" : "No")</td>
                            <td>@(reserva.Mesas.Count == 0 ? "—" : string.Join(", ", reserva.Mesas))</td>
                            <td class="text-end text-nowrap">
                                @if (string.Equals(reserva.Estado, "activa", StringComparison.OrdinalIgnoreCase) && reserva.Fecha >= hoy)
                                {
                                    @if (idCancelando == reserva.Id)
                                    {
                                        <button class="btn btn-sm btn-danger" @onclick="() => Cancelar(reserva.Id)">Confirmar</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => idCancelando = null">No</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => idCancelando = reserva.Id">Cancelar</button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    private long? socioId;
    private readonly DateOnly hoy = DateOnly.FromDateTime(DateTime.Today);
    private List<Fila>? reservas;
    private long? idCancelando;
    private string? error;
    private string? mensaje;

    private string ordenCampo = "fecha";
    private bool ordenDescendente = true;

    private List<IGrouping<(int Anio, int Mes), Fila>> Grupos =>
        (reservas ?? new List<Fila>())
            .GroupBy(r => (r.Fecha.Year, r.Fecha.Month))
            .OrderByDescending(g => g.Key)
            .ToList();

    private static string NombreMes((int Anio, int Mes) clave)
    {
        var nombre = new DateTime(clave.Anio, clave.Mes, 1)
            .ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-ES"));
        return char.ToUpperInvariant(nombre[0]) + nombre[1..];
    }

    private List<Fila> OrdenarGrupo(IEnumerable<Fila> grupo)
    {
        Func<Fila, object?> clave = ordenCampo switch
        {
            "id" => r => r.Id,
            "comensales" => r => r.Comensales,
            "tipo" => r => r.TipoReserva,
            "estado" => r => r.Estado,
            "limpieza" => r => r.Limpieza,
            _ => r => r.Fecha,
        };

        IEnumerable<Fila> resultado = ordenDescendente
            ? grupo.OrderByDescending(clave)
            : grupo.OrderBy(clave);

        return resultado.ToList();
    }

    private void Ordenar(string campo)
    {
        if (ordenCampo == campo)
        {
            ordenDescendente = !ordenDescendente;
        }
        else
        {
            ordenCampo = campo;
            ordenDescendente = false;
        }
    }

    private string Flecha(string campo) =>
        ordenCampo != campo ? string.Empty : ordenDescendente ? " ▼" : " ▲";

    protected override async Task OnInitializedAsync()
    {
        if (EstadoAutenticacion is null)
        {
            return;
        }

        var estado = await EstadoAutenticacion;
        socioId = SocioAuth.SocioId(estado.User);

        await Cargar();
    }

    private async Task Cargar()
    {
        if (socioId is null)
        {
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            reservas = await db.Reservas
                .AsNoTracking()
                .Where(r => r.SocioId == socioId)
                .OrderByDescending(r => r.Fecha)
                .ThenByDescending(r => r.Id)
                .Select(r => new Fila(
                    r.Id,
                    r.Fecha,
                    r.Comensales,
                    r.TipoReserva != null ? r.TipoReserva.Descripcion : "(sin tipo)",
                    r.Estado,
                    r.Limpieza,
                    r.ReservaMesas.Select(rm => rm.Mesa!.Descripcion).ToList()))
                .ToListAsync();

            error = null;
        }
        catch (Exception ex)
        {
            reservas ??= new List<Fila>();
            error = ex.Message;
        }
    }

    private async Task Cancelar(long id)
    {
        idCancelando = null;

        if (socioId is null)
        {
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // El filtro por SocioId, además del Id, evita cancelar una reserva ajena
            // aunque alguien manipule el id desde la consola del navegador.
            var filas = await db.Reservas
                .Where(r => r.Id == id && r.SocioId == socioId && r.Fecha >= hoy)
                .ExecuteUpdateAsync(r => r.SetProperty(x => x.Estado, "cancelada"));

            mensaje = filas > 0 ? "Reserva cancelada." : null;
            error = null;
            await Cargar();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private record Fila(
        long Id,
        DateOnly Fecha,
        int? Comensales,
        string TipoReserva,
        string? Estado,
        bool? Limpieza,
        List<string> Mesas);
}
