@page "/sugerencias"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Sugerencias</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">Sugerencias</h1>
    <button class="btn btn-pena" @onclick="Nuevo">Nueva sugerencia</button>
</div>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert"><code>@error</code></div>
}

@if (edicion is not null)
{
    <EditForm Model="edicion" OnValidSubmit="Guardar" class="card mb-4">
        <DataAnnotationsValidator />
        <div class="card-header fw-semibold">Nueva sugerencia</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label">Título</label>
                    <InputText class="form-control" @bind-Value="edicion.Titulo" />
                    <ValidationMessage For="() => edicion.Titulo" class="small" />
                </div>
                <div class="col-12">
                    <label class="form-label">Detalle</label>
                    <InputTextArea class="form-control" rows="4" @bind-Value="edicion.Descripcion" />
                    <ValidationMessage For="() => edicion.Descripcion" class="small" />
                </div>
            </div>
        </div>
        <div class="card-footer d-flex gap-2">
            <button type="submit" class="btn btn-pena">Guardar</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancelar">Cancelar</button>
        </div>
    </EditForm>
}

<div class="mb-3">
    <input class="form-control" placeholder="Buscar por socio, título, detalle o respuesta..."
           @bind="busqueda" @bind:event="oninput" />
</div>

@if (sugerencias is null)
{
    <p><em>Cargando...</em></p>
}
else if (Filtradas.Count == 0)
{
    <p><em>No hay sugerencias que coincidan con la búsqueda.</em></p>
}
else
{
    <div class="d-flex flex-column gap-2">
        @foreach (var s in Filtradas)
        {
            var respondida = !string.IsNullOrWhiteSpace(s.Respuesta);
            var expandida = idExpandido == s.Id;
            <div class="card">
                <div class="card-body py-2 d-flex align-items-center gap-3" role="button" @onclick="() => Expandir(s.Id)">
                    @if (!string.IsNullOrWhiteSpace(s.SocioFoto))
                    {
                        <img src="@s.SocioFoto" alt="@s.SocioNombre" class="rounded-circle" style="width:40px;height:40px;object-fit:cover;flex-shrink:0;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-secondary-subtle d-flex align-items-center justify-content-center" style="width:40px;height:40px;flex-shrink:0;">?</div>
                    }
                    <div class="flex-grow-1">
                        <div class="fw-semibold">@s.Titulo</div>
                        <div class="small text-muted">@s.SocioNombre · @s.Fecha?.ToString("dd/MM/yyyy")</div>
                    </div>
                    @if (respondida)
                    {
                        <span class="badge text-bg-success" title="Respondida">✓</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary" title="Pendiente de respuesta">Pte.</span>
                    }
                </div>

                @if (expandida)
                {
                    <div class="card-body border-top pt-3">
                        <p class="mb-3" style="white-space:pre-wrap;">@s.Descripcion</p>

                        @if (respondida)
                        {
                            <div class="alert alert-success mb-3">
                                <div class="fw-semibold mb-1">Respuesta de la junta</div>
                                <div style="white-space:pre-wrap;">@s.Respuesta</div>
                                @if (s.FechaRespuesta is not null)
                                {
                                    <div class="small text-muted mt-1">@s.FechaRespuesta?.ToString("dd/MM/yyyy")</div>
                                }
                            </div>
                        }

                        @if (esJunta)
                        {
                            <div class="mb-2">
                                <label class="form-label">@(respondida ? "Editar respuesta" : "Responder")</label>
                                <textarea class="form-control" rows="3" @bind="textoRespuesta"></textarea>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-pena" @onclick="() => Responder(s.Id)">Guardar respuesta</button>
                                @if (idBorrando == s.Id)
                                {
                                    <button class="btn btn-sm btn-danger" @onclick="() => Borrar(s.Id)">Confirmar borrado</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => idBorrando = null">No</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => idBorrando = s.Id">Borrar</button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    private long? socioId;
    private bool esJunta;
    private List<Fila>? sugerencias;
    private Sugerencia? edicion;
    private long? idExpandido;
    private long? idBorrando;
    private string? textoRespuesta;
    private string busqueda = string.Empty;
    private string? error;

    private List<Fila> Filtradas
    {
        get
        {
            if (sugerencias is null)
            {
                return new List<Fila>();
            }

            var texto = busqueda.Trim();
            if (texto.Length == 0)
            {
                return sugerencias;
            }

            return sugerencias.Where(s =>
                    Contiene(s.SocioNombre, texto) ||
                    Contiene(s.Titulo, texto) ||
                    Contiene(s.Descripcion, texto) ||
                    Contiene(s.Respuesta, texto))
                .ToList();
        }
    }

    private static bool Contiene(string? campo, string texto) =>
        !string.IsNullOrEmpty(campo) && campo.Contains(texto, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        if (EstadoAutenticacion is null)
        {
            return;
        }

        var estado = await EstadoAutenticacion;
        socioId = SocioAuth.SocioId(estado.User);
        esJunta = SocioAuth.EsJunta(estado.User);

        await Cargar();
    }

    private async Task Cargar()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            sugerencias = await db.Sugerencias
                .AsNoTracking()
                .OrderByDescending(s => s.Fecha)
                .ThenByDescending(s => s.Id)
                .Select(s => new Fila(
                    s.Id,
                    s.Fecha,
                    s.Titulo,
                    s.Descripcion,
                    s.Respuesta,
                    s.FechaRespuesta,
                    s.Socio != null ? $"{s.Socio.Nombre} {s.Socio.Apellidos}".Trim() : "Anónima",
                    s.Socio != null ? s.Socio.UrlFoto : null))
                .ToListAsync();

            error = null;
        }
        catch (Exception ex)
        {
            sugerencias ??= new List<Fila>();
            error = ex.Message;
        }
    }

    private void Nuevo()
    {
        edicion = new Sugerencia { SocioId = socioId };
        idExpandido = null;
    }

    private void Cancelar() => edicion = null;

    private async Task Guardar()
    {
        if (edicion is null)
        {
            return;
        }

        edicion.SocioId = socioId;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            db.Sugerencias.Add(edicion);
            await db.SaveChangesAsync();

            edicion = null;
            await Cargar();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private void Expandir(long id)
    {
        if (idExpandido == id)
        {
            idExpandido = null;
            return;
        }

        idExpandido = id;
        idBorrando = null;
        textoRespuesta = sugerencias?.FirstOrDefault(s => s.Id == id)?.Respuesta;
    }

    private async Task Responder(long id)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var texto = string.IsNullOrWhiteSpace(textoRespuesta) ? null : textoRespuesta.Trim();

            await db.Sugerencias.Where(s => s.Id == id)
                .ExecuteUpdateAsync(setters => setters
                    .SetProperty(s => s.Respuesta, texto)
                    .SetProperty(s => s.FechaRespuesta, texto is null
                        ? null
                        : DateTime.UtcNow));

            await Cargar();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task Borrar(long id)
    {
        idBorrando = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            await db.Sugerencias.Where(s => s.Id == id).ExecuteDeleteAsync();
            idExpandido = null;
            await Cargar();
        }
        catch (Exception ex)
        {
            error = $"No se pudo borrar la sugerencia: {ex.Message}";
        }
    }

    private record Fila(
        long Id,
        DateTime? Fecha,
        string? Titulo,
        string Descripcion,
        string? Respuesta,
        DateTime? FechaRespuesta,
        string SocioNombre,
        string? SocioFoto);
}
