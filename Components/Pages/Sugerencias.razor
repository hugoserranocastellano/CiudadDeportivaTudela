@page "/sugerencias"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Sugerencias</PageTitle>
<JuntaGuard />

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">Sugerencias</h1>
    <button class="btn btn-pena" @onclick="Nuevo">Nueva sugerencia</button>
</div>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert"><code>@error</code></div>
}

@if (edicion is not null)
{
    <EditForm Model="edicion" OnValidSubmit="Guardar" class="card mb-4">
        <DataAnnotationsValidator />
        <div class="card-header fw-semibold">@(esNuevo ? "Nueva sugerencia" : $"Editar sugerencia #{edicion.Id}")</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Socio</label>
                    <InputSelect class="form-select" @bind-Value="edicion.SocioId">
                        <option value="">(anónima)</option>
                        @foreach (var socio in socios)
                        {
                            <option value="@socio.Id">@socio.Texto</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check">
                        <InputCheckbox class="form-check-input" @bind-Value="visible" id="sugVisible" />
                        <label class="form-check-label" for="sugVisible">Visible para los socios</label>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label">Sugerencia</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="edicion.Descripcion" />
                </div>
                <div class="col-12">
                    <label class="form-label">Respuesta de la junta</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="respuesta" />
                    <div class="form-text">Al guardar una respuesta nueva se anota la fecha automáticamente.</div>
                </div>
            </div>
            <ValidationSummary class="mt-3 small" />
        </div>
        <div class="card-footer d-flex gap-2">
            <button type="submit" class="btn btn-pena">Guardar</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancelar">Cancelar</button>
        </div>
    </EditForm>
}

@if (sugerencias is null)
{
    <p><em>Cargando...</em></p>
}
else if (sugerencias.Count == 0)
{
    <p><em>No hay sugerencias registradas.</em></p>
}
else
{
    <p class="text-muted">
        @sugerencias.Count sugerencia(s),
        @(sugerencias.Count(s => string.IsNullOrWhiteSpace(s.Respuesta))) sin responder.
    </p>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Fecha</th>
                    <th>Socio</th>
                    <th>Sugerencia</th>
                    <th>Respuesta</th>
                    <th>Visible</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sugerencia in sugerencias)
                {
                    <tr class="@(string.IsNullOrWhiteSpace(sugerencia.Respuesta) ? "table-warning" : null)">
                        <td>@sugerencia.Id</td>
                        <td>@sugerencia.Fecha?.ToString("dd/MM/yyyy")</td>
                        <td>@NombreSocio(sugerencia.SocioId)</td>
                        <td>@sugerencia.Descripcion</td>
                        <td>
                            @sugerencia.Respuesta
                            @if (sugerencia.FechaRespuesta is not null)
                            {
                                <div class="text-muted small">@sugerencia.FechaRespuesta?.ToString("dd/MM/yyyy")</div>
                            }
                        </td>
                        <td>@(sugerencia.Visible == true ? "Sí" : "No")</td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Editar(sugerencia.Id)">Editar</button>
                            @if (idBorrando == sugerencia.Id)
                            {
                                <button class="btn btn-sm btn-danger" @onclick="() => Borrar(sugerencia.Id)">Confirmar</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => idBorrando = null">No</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => idBorrando = sugerencia.Id">Borrar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Fila>? sugerencias;
    private List<Opcion> socios = new();
    private Dictionary<long, string> nombresSocio = new();
    private Sugerencia? edicion;
    private bool esNuevo;
    private bool visible = true;
    private string? respuesta;
    private long? idBorrando;
    private string? error;

    private string NombreSocio(long? id) =>
        id is not null && nombresSocio.TryGetValue(id.Value, out var nombre) ? nombre : "Anónima";

    protected override Task OnInitializedAsync() => Cargar();

    private async Task Cargar()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            socios = (await db.Socios
                    .AsNoTracking()
                    .OrderBy(s => s.Nombre)
                    .Select(s => new { s.Id, s.Dni, s.Nombre, s.Apellidos })
                    .ToListAsync())
                .Select(s => new Opcion(s.Id, $"{s.Dni} · {s.Nombre} {s.Apellidos}".TrimEnd()))
                .ToList();

            nombresSocio = socios.ToDictionary(s => s.Id, s => s.Texto);

            sugerencias = await db.Sugerencias
                .AsNoTracking()
                .OrderByDescending(s => s.Fecha)
                .ThenByDescending(s => s.Id)
                .Select(s => new Fila(
                    s.Id,
                    s.Fecha,
                    s.SocioId,
                    s.Descripcion,
                    s.Respuesta,
                    s.FechaRespuesta,
                    s.Visible))
                .ToListAsync();

            error = null;
        }
        catch (Exception ex)
        {
            sugerencias ??= new List<Fila>();
            error = ex.Message;
        }
    }

    private void Nuevo()
    {
        edicion = new Sugerencia();
        visible = true;
        respuesta = null;
        esNuevo = true;
        idBorrando = null;
    }

    private async Task Editar(long id)
    {
        idBorrando = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            edicion = await db.Sugerencias.AsNoTracking().FirstOrDefaultAsync(s => s.Id == id);
            visible = edicion?.Visible != false;
            respuesta = edicion?.Respuesta;
            esNuevo = false;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private void Cancelar() => edicion = null;

    private async Task Guardar()
    {
        if (edicion is null)
        {
            return;
        }

        edicion.Visible = visible;

        // Sólo se sella la fecha cuando la respuesta cambia: reeditar una errata
        // no debería mover la fecha original.
        var textoRespuesta = string.IsNullOrWhiteSpace(respuesta) ? null : respuesta.Trim();

        if (textoRespuesta != edicion.Respuesta)
        {
            edicion.Respuesta = textoRespuesta;
            edicion.FechaRespuesta = textoRespuesta is null
                ? null
                : DateTime.SpecifyKind(DateTime.Now, DateTimeKind.Unspecified);
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            if (esNuevo)
            {
                db.Sugerencias.Add(edicion);
            }
            else
            {
                db.Sugerencias.Update(edicion);
            }

            await db.SaveChangesAsync();
            edicion = null;
            await Cargar();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task Borrar(long id)
    {
        idBorrando = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            await db.Sugerencias.Where(s => s.Id == id).ExecuteDeleteAsync();
            await Cargar();
        }
        catch (Exception ex)
        {
            error = $"No se pudo borrar la sugerencia: {ex.Message}";
        }
    }

    private record Fila(
        long Id,
        DateTime? Fecha,
        long? SocioId,
        string Descripcion,
        string? Respuesta,
        DateTime? FechaRespuesta,
        bool? Visible);

    private record Opcion(long Id, string Texto);
}
