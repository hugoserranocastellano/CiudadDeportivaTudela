@page "/directorio"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Socios</PageTitle>

<h1 class="mb-3">Socios</h1>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert">
        <h5 class="alert-heading">No se pudo completar la operación</h5>
        <p class="mb-0"><code>@error</code></p>
    </div>
}

@if (socios is null)
{
    <p><em>Cargando...</em></p>
}
else
{
    @if (junta.Count > 0)
    {
        <h2 class="h4 mb-3">Junta</h2>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3 mb-4">
            @foreach (var socio in junta)
            {
                <div class="col">
                    <div class="card h-100">
                        <div class="card-body d-flex align-items-center gap-3">
                            @if (!string.IsNullOrWhiteSpace(socio.UrlFoto))
                            {
                                <img src="@socio.UrlFoto" alt="@socio.Nombre" style="width:56px;height:56px;object-fit:cover;flex-shrink:0;" class="rounded-circle" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-secondary-subtle d-flex align-items-center justify-content-center" style="width:56px;height:56px;flex-shrink:0;">
                                    <span class="bi bi-person-fill" aria-hidden="true"></span>
                                </div>
                            }
                            <div class="min-width-0">
                                <div class="fw-semibold text-truncate">@socio.Nombre @socio.Apellidos</div>
                                <div class="text-muted small text-truncate">@socio.CategoriaSocio?.TipoSocio</div>
                                <div class="small text-truncate">@socio.Telefono</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <h2 class="h4 mb-3">Socios</h2>

    <div class="mb-3" style="max-width: 22rem;">
        <input class="form-control" placeholder="Buscar por nombre, apellidos o teléfono"
               value="@filtro" @oninput="e => filtro = e.Value?.ToString() ?? string.Empty" />
    </div>

    @if (Filtrados.Count == 0)
    {
        <p><em>No hay socios que coincidan.</em></p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
            @foreach (var socio in Filtrados)
            {
                <div class="col">
                    <div class="card h-100">
                        <div class="card-body d-flex align-items-center gap-3">
                            @if (!string.IsNullOrWhiteSpace(socio.UrlFoto))
                            {
                                <img src="@socio.UrlFoto" alt="@socio.Nombre" style="width:48px;height:48px;object-fit:cover;flex-shrink:0;" class="rounded-circle" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-secondary-subtle d-flex align-items-center justify-content-center" style="width:48px;height:48px;flex-shrink:0;">
                                    <span class="bi bi-person-fill" aria-hidden="true"></span>
                                </div>
                            }
                            <div class="min-width-0">
                                <div class="fw-semibold text-truncate">@socio.Nombre @socio.Apellidos</div>
                                <div class="small text-truncate">@socio.Telefono</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private List<Socio>? socios;
    private List<Socio> junta = new();
    private string filtro = string.Empty;
    private string? error;

    private List<Socio> Filtrados
    {
        get
        {
            if (socios is null)
            {
                return new List<Socio>();
            }

            IEnumerable<Socio> resultado = socios.Where(s => s.CategoriaSocio?.Junta != "SI");

            if (!string.IsNullOrWhiteSpace(filtro))
            {
                var texto = filtro.Trim();

                resultado = resultado.Where(s =>
                    s.Nombre.Contains(texto, StringComparison.OrdinalIgnoreCase)
                    || (s.Apellidos?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (s.Telefono?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return resultado.OrderBy(s => s.Nombre).ThenBy(s => s.Apellidos).ToList();
        }
    }

    protected override Task OnInitializedAsync() => Cargar();

    private async Task Cargar()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            socios = await db.Socios
                .AsNoTracking()
                .Include(s => s.CategoriaSocio)
                .Where(s => s.Activo != false)
                .ToListAsync();

            junta = socios
                .Where(s => s.CategoriaSocio?.Junta == "SI")
                .OrderBy(s => s.CategoriaId)
                .ToList();

            error = null;
        }
        catch (Exception ex)
        {
            socios ??= new List<Socio>();
            error = ex.Message;
        }
    }
}
